---
import { ClientRouter } from 'astro:transitions';
import Head, { type Props as HeadProps } from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../i18n/ui';

interface Props extends HeadProps {
  lang?: Lang;
}

const { lang = 'en', ...head } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <Head {...head} />
    <ClientRouter />
    <script is:inline>
      // dark is the default; runs before paint, and again after each ClientRouter swap
      function applyTheme() {
        document.documentElement.classList.toggle('dark', localStorage.getItem('theme') !== 'light');
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);

      // a link to the current page jumps (to its hash or the top) instead of reloading through the router; no smooth scroll, old browsers just jumped
      if (!window._samePageGuard) {
        window._samePageGuard = true;
        document.addEventListener(
          'click',
          function (e) {
            var a = e.target.closest('a[href]');
            if (!a) return;
            try {
              var dest = new URL(a.href, location.href);
              if (dest.origin === location.origin && dest.pathname === location.pathname) {
                e.stopImmediatePropagation();
                e.preventDefault();
                // waits for the clicked link's blink (see Layout's script) before jumping
                var still = matchMedia('(prefers-reduced-motion: reduce)').matches;
                setTimeout(
                  function () {
                    if (dest.hash) {
                      var target = document.querySelector(dest.hash);
                      if (target) target.scrollIntoView();
                      else location.hash = dest.hash;
                    } else {
                      window.scrollTo(0, 0);
                    }
                  },
                  still ? 0 : 320,
                );
              }
            } catch (_) {}
          },
          true,
        );
      }
    </script>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>

<script>
  import { onPageLoad } from '../utils/page';

  // old Internet Explorer's navigation "click", synthesized: two short bursts of filtered noise
  let audio: AudioContext | undefined;
  function navClick() {
    const ctx = (audio ??= new AudioContext());
    const len = ctx.sampleRate * 0.012;
    const buf = ctx.createBuffer(1, len, ctx.sampleRate);
    const data = buf.getChannelData(0);
    for (let i = 0; i < len; i++) data[i] = (Math.random() * 2 - 1) * (1 - i / len) ** 3;
    [0, 0.045].forEach((at) => {
      const src = ctx.createBufferSource();
      src.buffer = buf;
      const band = new BiquadFilterNode(ctx, { type: 'bandpass', frequency: 2500, Q: 1.5 });
      src
        .connect(band)
        .connect(new GainNode(ctx, { gain: 0.4 }))
        .connect(ctx.destination);
      src.start(ctx.currentTime + at);
    });
  }
  document.addEventListener('astro:before-preparation', navClick);
  // section links jump inside the home, so they never fire a navigation (from another page they do, and play there);
  // captured on window because the same-page guard above stops the click on document
  addEventListener(
    'click',
    (e) => {
      const link = (e.target as Element).closest<HTMLAnchorElement>('a[data-sec]');
      if (link?.pathname === location.pathname) navClick();
    },
    true,
  );

  // a clicked link blinks in inverse video before the browser moves on, like an old one did (styles in global.css);
  // captured on window so it runs before the same-page guard, which waits the same 320ms before jumping
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  addEventListener(
    'click',
    (e) => {
      const link = (e.target as Element).closest('a[href]');
      if (!link || still.matches) return;
      link.classList.remove('blink');
      void (link as HTMLElement).offsetWidth; // restarts the animation on a double click
      link.classList.add('blink');
      link.addEventListener('animationend', () => link.classList.remove('blink'), { once: true });
    },
    true,
  );
  document.addEventListener('astro:before-preparation', (e) => {
    if (!document.querySelector('a.blink')) return;
    const load = e.loader;
    e.loader = async () => {
      await new Promise((r) => setTimeout(r, 320));
      await load();
    };
  });

  // scroll reveal for `.reveal` blocks on every page (styles in global.css); a block paints once its top passes 90% of
  // the viewport. Checked on scroll instead of with an IntersectionObserver: a hidden block is fully clipped, and Chrome
  // never reports a clipped target as intersecting, while getBoundingClientRect ignores the clip
  onPageLoad((signal) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    // a post's body is rendered Markdown, so its blocks get the class here
    document.querySelectorAll('.post-body > *').forEach((el) => el.classList.add('reveal'));
    const below = (el: Element) => el.getBoundingClientRect().top > innerHeight * 0.9;
    // only hide what is not already on screen, so above-the-fold content never flashes
    let hidden = [...document.querySelectorAll('.reveal')].filter(below);
    hidden.forEach((el) => el.classList.add('pre'));
    const check = () => {
      hidden = hidden.filter((el) => {
        if (below(el)) return true;
        el.classList.remove('pre');
        return false;
      });
      if (!hidden.length) ctrl.abort();
    };
    const ctrl = new AbortController();
    const opts = { passive: true, signal: AbortSignal.any([signal, ctrl.signal]) };
    addEventListener('scroll', check, opts);
    addEventListener('resize', check, opts);
  });
</script>
