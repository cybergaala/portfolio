---
import { render } from 'astro:content';
import Layout from './Layout.astro';
import ProfileDialog from '../components/blog/ProfileDialog.astro';
import ReadingStatus from '../components/blog/ReadingStatus.astro';
import RelatedPosts from '../components/blog/RelatedPosts.astro';
import Tags from '../components/blog/Tags.astro';
import Toc from '../components/blog/Toc.astro';
import YouTube from '../components/YouTube.astro';
import { site } from '../data/site';
import { useTranslations } from '../i18n/ui';
import { blogUrl, postLang, postSlug, postUrl, readingTime, type Post } from '../utils/blog';

interface Props {
  post: Post;
  related: Post[];
  translation?: Post;
}

const { post, related, translation } = Astro.props;
const { title, description, pubDate, tags, banner } = post.data;
const { Content, headings } = await render(post);
const lang = postLang(post);
const slug = postSlug(post);
const t = useTranslations(lang);

const article = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  inLanguage: lang,
  author: { '@type': 'Person', name: site.name, url: Astro.site?.href },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};

const formatted = pubDate.toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC', // pubDate is a plain date, so read it in UTC or it shows the day before
});
---

<Layout
  title={`${title} — ${site.name}`}
  description={description}
  lang={lang}
  image={banner}
  publishedTime={pubDate}
  alternate={translation && { lang: postLang(translation), href: postUrl(translation) }}
  jsonLd={article}
>
  <ReadingStatus file={`${slug}.md`} />
  <article class="post-article">
    <div class="page-container">
      <a href={blogUrl(lang)} class="back-link">{t('blog.back')}</a>

      <header class="post-header">
        <p class="cmd"><span class="path">~/blog</span> $ cat {slug}.md</p>
        <p class="section-label">
          <time datetime={pubDate.toISOString()}>{formatted}</time>
          <span class="reading-time-sep">·</span>
          <span class="reading-time-label">{readingTime(post)} {t('blog.min-read')}</span>
        </p>
        <h1 class="post-title">{title}</h1>
        <p class="post-desc">{description}</p>
        <ProfileDialog />
        <Tags tags={tags} />
        {translation && (
          <p class="lang-switcher">
            {lang === 'en'
              ? <><strong>ENG</strong>{' | '}<a href={postUrl(translation)} hreflang="es">SPA</a></>
              : <><a href={postUrl(translation)} hreflang="en">ENG</a>{' | '}<strong>SPA</strong></>
            }
          </p>
        )}
      </header>

      {banner && (
        <div class="post-banner">
          <img src={banner} alt="" />
        </div>
      )}

      <div class="post-layout">
        <div class="post-body">
          <Content components={{ YouTube }} />
        </div>
        <Toc headings={headings} label={t('blog.on-this-page')} />
      </div>

      <div class="post-end">
        <span class="post-end-marker" aria-hidden="true">· · ·</span>
        <button id="back-to-top" class="back-to-top">↑ {t('blog.back-to-top')}</button>
      </div>

      <RelatedPosts posts={related} label={t('blog.related')} />
    </div>
  </article>
</Layout>

<style>
  /* colors come from the theme tokens in global.css, so dark mode needs no overrides */
  .post-article { padding: 8rem 0; }

  .back-link {
    display: inline-block;
    margin-bottom: 2.5rem;
    font: 0.8rem var(--font-mono);
    color: var(--fg-faint);
    text-decoration: none;
  }

  .back-link:hover { color: var(--accent); }

  .post-header {
    padding-bottom: 2.5rem;
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--border);
  }

  .post-header .cmd { margin-bottom: 0.4rem; }

  .section-label {
    margin: 0 0 1rem;
    font: 0.78rem/1.4 var(--font-mono);
    color: var(--syn-type);
  }

  .reading-time-sep { margin: 0 0.5ch; color: var(--fg-faint); }
  .reading-time-label { color: var(--fg-faint); }

  .post-title {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 600;
    line-height: 1.08;
    color: var(--fg);
  }

  /* speech bubble: the tail is a rotated square whose bottom-right corner points down at the avatar */
  .post-desc {
    position: relative;
    margin: 0 0 1rem;
    padding: 0.85rem 1.1rem;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--fg-muted);
    /* a touch of the text color: slightly darker on the light theme, slightly lighter on the dark one */
    background: color-mix(in srgb, var(--body-bg), var(--fg) 5%);
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .post-desc::after {
    content: '';
    position: absolute;
    bottom: -0.45rem;
    left: 0.85rem; /* centers the tail over the 2.5rem avatar */
    width: 0.8rem;
    height: 0.8rem;
    background: inherit;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    transform: rotate(45deg);
  }

  .lang-switcher {
    width: fit-content;
    margin: 1.25rem 0 0 auto;
    font: 0.75rem var(--font-mono);
    color: var(--fg-faint);
  }

  .lang-switcher strong { color: var(--accent); }
  .lang-switcher a { color: var(--fg-faint); text-decoration: none; }
  .lang-switcher a:hover { color: var(--fg); }

  /* Banner */
  .post-banner {
    width: 100%;
    aspect-ratio: 12 / 5.9;
    overflow: hidden;
    margin-bottom: 3rem;
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .post-banner img { display: block; width: 100%; height: 100%; object-fit: cover; transition: filter 0.5s ease; }

  :global(.img-blur-load) { filter: blur(20px) !important; will-change: filter; }

  /* Layout: content + TOC */
  .post-layout { display: grid; grid-template-columns: 42rem 1fr; gap: 0 4rem; align-items: start; }

  @media (max-width: 900px) {
    .post-layout { grid-template-columns: 1fr; }
  }

  /* Body */
  .post-body {
    min-width: 0;
    font-size: 1rem;
    line-height: 1.8;
    color: var(--fg-muted);
    text-align: justify;
    hyphens: auto;
  }

  .post-body :global(h2),
  .post-body :global(h3) {
    color: var(--fg);
    text-align: left;
  }

  .post-body :global(h2) { margin: 2.75rem 0 0.75rem; font-size: 1.4rem; font-weight: 600; }
  .post-body :global(h3) { margin: 2rem 0 0.5rem; font-size: 1.1rem; font-weight: 600; }

  /* markdown heading marks, like the raw .md */
  .post-body :global(h2)::before,
  .post-body :global(h3)::before { font: 400 0.8em var(--font-mono); color: var(--accent); }
  .post-body :global(h2)::before { content: "## "; }
  .post-body :global(h3)::before { content: "### "; }

  .post-body :global(p) { margin: 0 0 1.25rem; }

  /* drop cap as a terminal block cursor: inverted cell, exactly two body lines tall (2 × 1.8em) */
  .post-body :global(> p:first-of-type::first-letter) {
    float: left;
    margin: 0.12em 0.3em 0 0; /* in the cap's own em: nudges it down onto the first line's x-height */
    padding: 0 0.18em;
    font-size: 2.5em;
    font-weight: 700;
    line-height: 1.3; /* 2.5 × 1.3 = 3.25em, plus the margin stays under the 3.6em of two lines */
    color: var(--body-bg);
    background: var(--accent);
    border-radius: 3px;
  }

  .post-body :global(ul) { list-style: none; padding-left: 0; margin: 0 0 1.25rem; }
  .post-body :global(ul li) { position: relative; padding-left: 1.5rem; margin-bottom: 0.5rem; }
  .post-body :global(ul li::before) { content: "-"; position: absolute; left: 0.2rem; font-family: var(--font-mono); color: var(--accent); }

  .post-body :global(ol) { padding-left: 1.25rem; margin: 0 0 1.25rem; }
  .post-body :global(ol li) { margin-bottom: 0.5rem; }
  .post-body :global(ol li::marker) { font-family: var(--font-mono); color: var(--accent); }

  .post-body :global(strong) { font-weight: 600; color: var(--fg); }

  .post-body :global(a) { color: var(--accent); text-underline-offset: 3px; }
  .post-body :global(a:hover) { background: var(--accent-soft); }

  .post-body :global(code) {
    padding: 0.1em 0.35em;
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--syn-type);
    background: var(--accent-soft);
    border-radius: 3px;
  }

  .post-body :global(pre) {
    margin: 0 0 1.5rem;
    padding: 1rem 0.9rem;
    overflow-x: auto;
    text-align: left;
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .post-body :global(pre code) { padding: 0; font-size: 0.82rem; color: inherit; background: none; }
  :global(html.dark) .post-body :global(pre .line) { background-color: transparent !important; }

  .post-body :global(blockquote) {
    margin: 0 0 1.25rem;
    padding: 0.1rem 0 0.1rem 1.25rem;
    color: var(--fg-faint);
    font-style: italic;
    border-left: 2px solid var(--accent);
  }

  .post-body :global(hr) { margin: 2.5rem 0; border: none; border-top: 1px dashed var(--border); }

  .post-body :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 2rem 0;
    border: 1px solid var(--border);
    border-radius: 8px;
    transition: filter 0.5s ease;
  }

  /* Image followed by blockquote → render blockquote as caption, hanging off the photo like a tree branch */
  .post-body :global(p:has(img):has(+ blockquote)) { margin-bottom: 0; }
  .post-body :global(p:has(img):has(+ blockquote) img) { margin-bottom: 0.6rem; }

  .post-body :global(p:has(img) + blockquote) {
    position: relative;
    margin: 0 0 2rem;
    padding: 0 0 0 3.25ch; /* hanging indent so wrapped lines align after the branch */
    font: normal 0.8rem/1.6 var(--font-mono);
    color: var(--fg-muted);
    border: none;
  }

  .post-body :global(p:has(img) + blockquote)::before { content: "└─"; position: absolute; left: 0.25ch; color: var(--accent); }
  .post-body :global(p:has(img) + blockquote p) { margin: 0; }
  .post-body :global(p:has(img) + blockquote strong) { color: var(--fg); }

  /* End of post */
  .post-end {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    max-width: 42rem;
    margin-top: 4rem;
    font-family: var(--font-mono);
  }

  .post-end-marker { letter-spacing: 0.4em; color: var(--fg-faint); user-select: none; }

  .back-to-top {
    padding: 0.1rem 0.5rem;
    font: 0.75rem var(--font-mono);
    color: var(--fg-faint);
    background: none;
    border: none;
    border-radius: 3px;
    cursor: pointer;
  }

  .back-to-top:hover, .back-to-top:focus-visible { color: var(--fg); background: var(--accent-soft); outline: none; }
</style>

<script>
  import { onPageLoad } from '../utils/page';

  function initBlurUp() {
    const images = document.querySelectorAll<HTMLImageElement>('.post-banner img, .post-body img');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const img = entry.target as HTMLImageElement;
        observer.unobserve(img);
        if (img.complete && img.naturalWidth > 0) return;
        img.classList.add('img-blur-load');
        const reveal = () => img.classList.remove('img-blur-load');
        img.addEventListener('load', reveal, { once: true });
        img.addEventListener('error', reveal, { once: true });
      });
    }, { rootMargin: '200px' });

    images.forEach((img) => observer.observe(img));
  }

  onPageLoad(() => {
    document.getElementById('back-to-top')?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    initBlurUp();
  });
</script>
