---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Layout from './Layout.astro';
import ProfileDialog from '../components/blog/ProfileDialog.astro';
import ReadingStatus from '../components/blog/ReadingStatus.astro';
import RelatedPosts from '../components/blog/RelatedPosts.astro';
import Tags from '../components/blog/Tags.astro';
import Toc from '../components/blog/Toc.astro';
import YouTube from '../components/YouTube.astro';
import { site } from '../data/site';
import { useTranslations } from '../i18n/ui';
import { blogUrl, postLang, postSlug, postUrl, readingTime, type Post } from '../utils/blog';

interface Props {
  post: Post;
  related: Post[];
  translation?: Post;
}

const { post, related, translation } = Astro.props;
const { title, description, pubDate, tags, banner, warning } = post.data;
const { Content, headings } = await render(post);
const lang = postLang(post);
const slug = postSlug(post);
const t = useTranslations(lang);

const article = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  inLanguage: lang,
  author: { '@type': 'Person', name: site.name, url: Astro.site?.href },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};

const formatted = pubDate.toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC', // pubDate is a plain date, so read it in UTC or it shows the day before
});
---

<Layout
  title={`${title} — ${site.name}`}
  description={description}
  lang={lang}
  image={banner?.src}
  publishedTime={pubDate}
  alternate={translation && { lang: postLang(translation), href: postUrl(translation) }}
  jsonLd={article}
>
  <ReadingStatus file={`${slug}.md`}>
    {translation && (
      <span class="lang-switcher">
        {lang === 'en' ? (
          <>
            <strong>ENG</strong>
            {' | '}
            <a href={postUrl(translation)} hreflang="es">
              SPA
            </a>
          </>
        ) : (
          <>
            <a href={postUrl(translation)} hreflang="en">
              ENG
            </a>
            {' | '}
            <strong>SPA</strong>
          </>
        )}
      </span>
    )}
  </ReadingStatus>
  <article class="post-article">
    <div class="page-container">
      <header class="post-header">
        <p class="cmd">
          <a href={blogUrl(lang)} class="path">
            ~/blog
          </a>{' '}
          $ cat {slug}.md
        </p>
        <div class:list={['post-cover', { 'post-banner': banner }]}>
          {banner && (
            <Image
              src={banner}
              alt=""
              widths={[720, 1080, 1440, 1920]}
              sizes="100vw"
              loading="eager"
              fetchpriority="high"
            />
          )}
          <div class="post-cover-text">
            <p class="section-label">
              <time datetime={pubDate.toISOString()}>{formatted}</time>
              <span class="reading-time-sep">·</span>
              <span class="reading-time-label">
                {readingTime(post)} {t('blog.min-read')}
              </span>
            </p>
            <h1 class="post-title">{title}</h1>
          </div>
        </div>
        <p class="post-desc">{description}</p>
        <ProfileDialog />
        <Tags tags={tags} />
        {warning && (
          <p class="post-warning" role="note">
            <span class="post-warning-icon" aria-hidden="true">
              i
            </span>
            {warning}
          </p>
        )}
      </header>

      <div class="post-layout">
        <div class="post-body">
          <Content components={{ YouTube }} />
        </div>
        <Toc headings={headings} label={t('blog.on-this-page')} />
      </div>

      <div class="post-end">
        <span class="post-end-marker" aria-hidden="true">
          · · ·
        </span>
        <button id="back-to-top" class="back-to-top">
          ↑ {t('blog.back-to-top')}
        </button>
      </div>

      <RelatedPosts posts={related} label={t('blog.related')} />
    </div>
  </article>

  <dialog id="viewer" class="viewer">
    <img alt="" />
    <p class="viewer-bar">
      <button data-step="-1">{t('blog.prev')}</button>
      <span class="viewer-count"></span>
      <button data-step="1">{t('blog.next')}</button>
      <button data-close>[esc] {t('blog.close')}</button>
    </p>
  </dialog>
</Layout>

<style>
  /* colors come from the theme tokens in global.css, so dark mode needs no overrides */
  .post-article {
    padding: 8rem 0;
  }

  /* ~/blog in the prompt is the way back to the list */
  .post-header a.path {
    text-decoration: none;
  }
  .post-header a.path:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-header {
    padding-bottom: 2.5rem;
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--border);
  }

  .post-header .cmd {
    margin-bottom: 0.4rem;
  }

  .section-label {
    margin: 0 0 1rem;
    font: 0.78rem/1.4 var(--font-mono);
    color: var(--syn-type);
  }

  .reading-time-sep {
    margin: 0 0.5ch;
    color: var(--fg-faint);
  }
  .reading-time-label {
    color: var(--fg-faint);
  }

  .post-title {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 600;
    line-height: 1.08;
    color: var(--fg);
  }

  /* speech bubble: the tail is a rotated square whose bottom-right corner points down at the avatar */
  .post-desc {
    position: relative;
    margin: 0 0 1rem;
    padding: 0.85rem 1.1rem;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--fg-muted);
    /* a touch of the text color: slightly darker on the light theme, slightly lighter on the dark one */
    background: color-mix(in srgb, var(--body-bg), var(--fg) 5%);
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .post-desc::after {
    content: '';
    position: absolute;
    bottom: -0.45rem;
    left: 0.85rem; /* centers the tail over the 2.5rem avatar */
    width: 0.8rem;
    height: 0.8rem;
    background: inherit;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    transform: rotate(45deg);
  }

  .lang-switcher {
    pointer-events: auto; /* the status line itself ignores the pointer */
    color: var(--fg-faint);
  }

  .lang-switcher strong {
    color: var(--accent);
  }
  .lang-switcher a {
    color: var(--fg-faint);
    text-decoration: none;
  }
  .lang-switcher a:hover {
    color: var(--fg);
  }

  /* Warning box */
  .post-warning {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 1.5rem 0 0;
    padding: 0.75rem 1rem;
    border: 1px solid var(--warn);
    border-radius: 8px;
    background: var(--warn-soft);
    color: var(--fg-muted);
    font-size: 0.875rem;
  }
  .post-warning-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border: 1px solid var(--warn);
    border-radius: 50%;
    color: var(--warn);
    font-weight: 700;
    font-size: 0.75rem;
  }

  /* Banner: the cover, with the date and title over it, so it can't pass for one more post photo */
  /* full bleed: the negative margins stretch it from the container to both edges of the window
     (body clips the scrollbar's width that 100vw counts) */
  .post-banner {
    position: relative;
    /* not aspect-ratio + max-height: that pair shrinks the width too, leaving a gap on the right */
    height: min(100vw * 5.9 / 12, 75vh);
    overflow: hidden;
    margin: 0.75rem calc(50% - 50vw) 1.5rem;
    border-block: 1px solid var(--border);
  }

  .post-banner .post-cover-text {
    position: absolute;
    inset: auto 0 0;
    /* the text lines up with the page column, not the window edge */
    padding: 4rem max(1rem, 50vw - 31rem) 1.25rem;
    /* the shade keeps the text readable on any photo, in either theme */
    background: linear-gradient(transparent, var(--photo-shade));
  }

  .post-banner .section-label,
  .post-banner .reading-time-sep,
  .post-banner .reading-time-label,
  .post-banner .post-title {
    color: var(--on-photo);
  }

  .post-banner .post-title {
    margin: 0;
  }

  @media (max-width: 640px) {
    .post-banner {
      height: 75vw; /* 4:3, room for a title that wraps */
    }
    .post-banner .post-cover-text {
      padding-top: 3rem;
      padding-bottom: 1rem;
    }
  }

  .post-banner img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: filter 0.5s ease;
  }

  :global(.img-blur-load) {
    filter: blur(20px) !important;
    will-change: filter;
  }

  /* Layout: content + TOC */
  .post-layout {
    display: grid;
    /* fixed TOC width, so switching language doesn't resize the columns */
    grid-template-columns: minmax(0, 1fr) 13rem;
    gap: 0 2.5rem;
    align-items: start;
  }

  /* no h2s → Toc renders nothing, so the content takes the full width */
  .post-layout:not(:has(> aside)) {
    grid-template-columns: minmax(0, 1fr);
  }

  /* the end of the post lines up with the body column, so it only leaves room when there's a TOC */
  .page-container:has(.post-layout > aside) > .post-end,
  .page-container:has(.post-layout > aside) > :global(.related-posts) {
    max-width: calc(100% - 15.5rem); /* TOC column + gap */
  }

  @media (max-width: 900px) {
    .post-layout {
      grid-template-columns: 1fr;
    }

    .page-container:has(.post-layout > aside) > .post-end,
    .page-container:has(.post-layout > aside) > :global(.related-posts) {
      max-width: none;
    }
  }

  /* Body */
  .post-body {
    min-width: 0;
    font-size: 1rem;
    line-height: 1.8;
    color: var(--fg-muted);
    text-align: justify;
    hyphens: auto;
  }

  .post-body :global(h2),
  .post-body :global(h3) {
    color: var(--fg);
    text-align: left;
  }

  .post-body :global(h2) {
    margin: 2.75rem 0 0.75rem;
    font-size: 1.4rem;
    font-weight: 600;
  }
  .post-body :global(h3) {
    margin: 2rem 0 0.5rem;
    font-size: 1.1rem;
    font-weight: 600;
  }

  /* markdown heading marks, like the raw .md */
  .post-body :global(h2)::before,
  .post-body :global(h3)::before {
    font: 400 0.8em var(--font-mono);
    color: var(--accent);
  }
  .post-body :global(h2)::before {
    content: '## ';
  }
  .post-body :global(h3)::before {
    content: '### ';
  }

  .post-body :global(p) {
    margin: 0 0 1.25rem;
  }

  .post-body :global(ul) {
    list-style: none;
    padding-left: 0;
    margin: 0 0 1.25rem;
  }
  .post-body :global(ul li) {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .post-body :global(ul li::before) {
    content: '-';
    position: absolute;
    left: 0.2rem;
    font-family: var(--font-mono);
    color: var(--accent);
  }

  .post-body :global(ol) {
    padding-left: 1.25rem;
    margin: 0 0 1.25rem;
  }
  .post-body :global(ol li) {
    margin-bottom: 0.5rem;
  }
  .post-body :global(ol li::marker) {
    font-family: var(--font-mono);
    color: var(--accent);
  }

  .post-body :global(strong) {
    font-weight: 600;
    color: var(--fg);
  }

  .post-body :global(a) {
    color: var(--accent);
    text-underline-offset: 3px;
  }
  .post-body :global(a:hover) {
    background: var(--accent-soft);
  }

  .post-body :global(code) {
    padding: 0.1em 0.35em;
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--syn-type);
    background: var(--accent-soft);
    border-radius: 3px;
  }

  .post-body :global(pre) {
    margin: 0 0 1.5rem;
    padding: 1rem 0.9rem;
    overflow-x: auto;
    text-align: left;
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .post-body :global(pre code) {
    padding: 0;
    font-size: 0.82rem;
    color: inherit;
    background: none;
  }
  :global(html.dark) .post-body :global(pre .line) {
    background-color: transparent !important;
  }

  .post-body :global(blockquote) {
    margin: 0 0 1.25rem;
    padding: 0.1rem 0 0.1rem 1.25rem;
    color: var(--fg-faint);
    font-style: italic;
    border-left: 2px solid var(--accent);
  }

  .post-body :global(hr) {
    margin: 2.5rem 0;
    border: none;
    border-top: 1px dashed var(--border);
  }

  .post-body :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 2rem 0;
    border: 1px solid var(--border);
    border-radius: 8px;
    transition: filter 0.5s ease;
    cursor: zoom-in;
  }

  /* Image viewer */
  :global(html:has(.viewer[open])) {
    overflow: hidden;
  }

  .viewer[open] {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 1rem;
    border: none;
    background: var(--body-bg);
    color: var(--fg-faint);
    font: 0.8rem var(--font-mono);
  }

  .viewer::backdrop {
    background: var(--body-bg);
  }

  .viewer img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .viewer-bar {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin: 0.75rem 0 0;
  }

  .viewer-bar button {
    background: none;
    border: none;
    padding: 0;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .viewer-bar button:hover {
    color: var(--accent);
  }

  /* Image followed by blockquote → render blockquote as caption, hanging off the photo like a tree branch */
  .post-body :global(p:has(img):has(+ blockquote)) {
    margin-bottom: 0;
  }
  .post-body :global(p:has(img):has(+ blockquote) img) {
    margin-bottom: 0.6rem;
  }

  .post-body :global(p:has(img) + blockquote) {
    position: relative;
    margin: 0 0 2rem;
    padding: 0 0 0 3.25ch; /* hanging indent so wrapped lines align after the branch */
    font: normal 0.8rem/1.6 var(--font-mono);
    color: var(--fg-muted);
    border: none;
  }

  .post-body :global(p:has(img) + blockquote)::before {
    content: '└─';
    position: absolute;
    left: 0.25ch;
    color: var(--accent);
  }
  .post-body :global(p:has(img) + blockquote p) {
    margin: 0;
  }
  .post-body :global(p:has(img) + blockquote strong) {
    color: var(--fg);
  }

  /* End of post */
  .post-end {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    margin-top: 4rem;
    font-family: var(--font-mono);
  }

  .post-end-marker {
    letter-spacing: 0.4em;
    color: var(--fg-faint);
    user-select: none;
  }

  .back-to-top {
    padding: 0.1rem 0.5rem;
    font: 0.75rem var(--font-mono);
    color: var(--fg-faint);
    background: none;
    border: none;
    border-radius: 3px;
    cursor: pointer;
  }

  .back-to-top:hover,
  .back-to-top:focus-visible {
    color: var(--fg);
    background: var(--accent-soft);
    outline: none;
  }
</style>

<script>
  import { onPageLoad } from '../utils/page';

  function initBlurUp() {
    const images = document.querySelectorAll<HTMLImageElement>('.post-banner img, .post-body img');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const img = entry.target as HTMLImageElement;
          observer.unobserve(img);
          if (img.complete && img.naturalWidth > 0) return;
          img.classList.add('img-blur-load');
          const reveal = () => img.classList.remove('img-blur-load');
          img.addEventListener('load', reveal, { once: true });
          img.addEventListener('error', reveal, { once: true });
        });
      },
      { rootMargin: '200px' },
    );

    images.forEach((img) => observer.observe(img));
  }

  // Language switch: no fade, same scroll, and the visible text scrambles into the other language,
  // so it feels like the same page changing instead of a new one loading.
  const LOWER = 'abcdefghijklmnopqrstuvwxyz';
  const UPPER = LOWER.toUpperCase();
  const SCRAMBLE_MS = 400;
  const SCRAMBLE_TICK = 40; // ms between glyph changes; changing every frame reads as flicker
  const LETTER = /[\p{L}\p{N}]/u;
  // same in both languages (command line, author, tags, ENG | SPA) or code, so they stay still
  const NO_SCRAMBLE = 'pre, code, .cmd, .post-author, .post-tags, .lang-switcher';
  let langSwapY: number | null = null;

  document.addEventListener(
    'click',
    (e) => {
      if (!(e.target as Element).closest?.('.lang-switcher a')) return;
      langSwapY = scrollY;
      document.documentElement.classList.add('lang-swap');
    },
    true,
  );
  document.addEventListener('astro:before-swap', (e) => {
    if (langSwapY === null) return;
    e.newDocument.documentElement.classList.add('lang-swap');
    // page-load fires before the view transition ends; dropping the class sooner brings back the page fade
    e.viewTransition.finished.finally(() => document.documentElement.classList.remove('lang-swap'));
  });
  document.addEventListener('astro:after-swap', () => {
    if (langSwapY === null) return;
    scrollTo({ top: langSwapY, behavior: 'instant' });
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) scrambleVisibleText();
  });

  function scrambleVisibleText() {
    const nodes: { node: Text; text: string; at: number[] }[] = [];
    document.querySelectorAll('.post-header, .post-body, .post-toc').forEach((root) => {
      const walk = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
      for (let n = walk.nextNode() as Text | null; n; n = walk.nextNode() as Text | null) {
        const r = n.parentElement?.getBoundingClientRect();
        // ponytail: on-screen text only; whatever is off-screen just swaps, nobody sees it
        if (!r || r.bottom < 0 || r.top > innerHeight || !n.data.trim() || n.parentElement!.closest(NO_SCRAMBLE))
          continue;
        // each letter settles at its own time: mostly left to right, with some jitter so it doesn't read as a wipe
        const at = [...n.data].map((_, i, a) => (i / a.length) * 0.6 + Math.random() * 0.4);
        nodes.push({ node: n, text: n.data, at });
      }
    });
    const start = performance.now();
    let lastTick = -1;
    const frame = (now: number) => {
      const p = Math.min((now - start) / SCRAMBLE_MS, 1);
      const tick = Math.floor((now - start) / SCRAMBLE_TICK);
      if (tick === lastTick && p < 1) return void requestAnimationFrame(frame);
      lastTick = tick;
      for (const n of nodes) {
        // only letters and digits scramble, so spaces and punctuation keep the shape of the text
        const out = [...n.text]
          .map((c, i) => {
            if (p >= n.at[i] || !LETTER.test(c)) return c;
            const set = c === c.toLowerCase() ? LOWER : UPPER;
            return set[(Math.random() * set.length) | 0];
          })
          .join('');
        if (n.node.data !== out) n.node.data = out;
      }
      if (p < 1) requestAnimationFrame(frame);
    };
    frame(start); // first frame right away, so the new text never shows unscrambled
  }

  // Click a post image to open it full size; arrows, swipe and the buttons move through the others.
  function initViewer() {
    const dialog = document.getElementById('viewer') as HTMLDialogElement | null;
    const imgs = [...document.querySelectorAll<HTMLImageElement>('.post-body img')];
    if (!dialog || !imgs.length) return;
    const view = dialog.querySelector('img')!;
    const count = dialog.querySelector('.viewer-count')!;
    dialog.querySelectorAll<HTMLElement>('[data-step]').forEach((b) => (b.hidden = imgs.length < 2));
    let i = 0;

    const show = (n: number) => {
      i = (n + imgs.length) % imgs.length;
      const img = imgs[i];
      // the size already on screen shows right away; src is the original, swapped in once it loads
      view.src = img.currentSrc || img.src;
      view.alt = img.alt;
      count.textContent = `${i + 1}/${imgs.length}`;
      const full = new Image();
      full.onload = () => imgs[i] === img && (view.src = full.src);
      full.src = img.src;
    };

    imgs.forEach((img, n) =>
      img.addEventListener('click', () => {
        show(n);
        dialog.showModal();
      }),
    );
    dialog.addEventListener('click', (e) => {
      const el = e.target as HTMLElement;
      if (el.dataset.step) show(i + Number(el.dataset.step));
      else if (el !== view) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(i - 1);
      if (e.key === 'ArrowRight') show(i + 1);
    });
    let touchX = 0;
    dialog.addEventListener('touchstart', (e) => (touchX = e.touches[0].clientX), { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - touchX;
      if (Math.abs(dx) > 50) show(i - Math.sign(dx));
    });
  }

  onPageLoad(() => {
    initViewer();
    document
      .getElementById('back-to-top')
      ?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    initBlurUp();
    langSwapY = null;
  });
</script>
