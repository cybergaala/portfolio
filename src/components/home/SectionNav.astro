---
// Fixed timeline of the landing's sections; Header.astro marks the one on screen as active.
const sections = [
  ['hero', 'Home'],
  ['projects', 'Projects'],
  ['writing', 'Writing'],
  ['experience', 'Experience'],
  ['contact', 'Contact'],
];
---

<nav class="history mono" aria-label="Sections">
  <ol>
    {sections.map(([id, label]) => (
      <li>
        <a href={`#${id}`} data-sec={id}>
          {label}
        </a>
      </li>
    ))}
  </ol>
</nav>

<style>
  /* wide screens only */
  .history {
    display: none;
  }

  @media (min-width: 1360px) {
    .history {
      display: block;
      position: fixed;
      top: 50%;
      left: 2rem;
      z-index: 5;
      transform: translateY(-50%);
      font-size: 0.8rem;
      transition: opacity 0.3s;
    }
  }

  /* faded when no command is running (e.g. between sections) */
  .history:not(:has(.active)) {
    opacity: 0.45;
  }

  /* fzf: the running section is the selected line */
  .history ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .history a {
    display: block;
    padding: 0.3rem 0.75rem 0.3rem 0;
    color: var(--fg-faint);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 0.2s,
      background 0.2s;
  }
  .history a::before {
    content: '  ';
    white-space: pre;
    color: var(--accent);
  }
  .history a:hover {
    color: var(--fg);
  }

  /* already ran: every command before the running one */
  .history li:has(~ li .active) a {
    color: var(--fg-muted);
  }

  /* selected line */
  .history a.active {
    color: var(--fg);
    background: var(--accent-soft);
  }
  .history a.active::before {
    content: '~ ';
  }
</style>
