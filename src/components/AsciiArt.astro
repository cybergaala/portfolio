---
import { artToHtml } from '../data/art-html';

// Renders art from scripts/ascii-art.py in a post.
// paper pins the background the art was made for, so it reads the same in either site theme.
interface Props {
  rows: string[][][];
  paper?: 'dark' | 'light';
  label: string;
}

const { rows, paper = 'dark', label } = Astro.props;

const html = artToHtml(rows);
---

<figure class="ascii-art">
  <pre class={paper} role="img" aria-label={label} set:html={html} />
</figure>

<style>
  .ascii-art {
    margin: 1.5rem 0;
    container-type: inline-size;
  }

  /* 128 columns of 0.6em glyphs = 76.8em: size the font from the figure's own width so the piece
     fills the column edge to edge; .ascii-art pre outranks the post's code block styles */
  .ascii-art pre {
    margin: 0;
    padding: 0;
    overflow: hidden;
    font: calc((100cqi - 2px) / 76.8) / 1 var(--font-mono);
    letter-spacing: 0;
    border: 1px solid var(--border);
    border-radius: 8px;
    user-select: none;
  }

  .dark {
    background: #141417;
  }
  .light {
    background: #f6f6f4;
  }
</style>
