---
// The post author's avatar; clicking it opens a lazygit-style profile panel in a native <dialog>.
import { site } from '../../data/site';

const epithets = [
  'Invincible',
  'Fearless',
  'Sensual',
  'Mysterious',
  'Enchanting',
  'Vigorous',
  'Diligent',
  'Overwhelming',
  'Gorgeous',
  'Passionate',
  'Terrifying',
  'Beautiful',
  'Powerful',
];
---

<p class="post-author">
  <button
    type="button"
    class="post-avatar"
    id="profile-open"
    aria-haspopup="dialog"
    aria-label="Open profile"
    style={`--photo: url('${site.photo}')`}
  ></button>
  {site.name}
</p>
<dialog class="profile" id="profile" aria-labelledby="profile-title">
  <span class="profile-title" id="profile-title">
    Profile
  </span>
  <form method="dialog">
    <button class="profile-close" aria-label="Close">
      [x]
    </button>
  </form>
  <div class="profile-body">
    <img src={site.photo} alt="" class="profile-photo" loading="lazy" />
    <div class="profile-info">
      <div class="profile-foot">
        <!-- Grey Prince Zote's title card (Hollow Knight); spills out of the dialog on purpose -->
        <ul class="profile-epithets">
          {epithets.map((e) => (
            <li>{e}</li>
          ))}
        </ul>
        <p class="profile-links">
          <a href={site.github} target="_blank" rel="noopener">
            github ↗
          </a>
          <a href={site.linkedin} target="_blank" rel="noopener">
            linkedin ↗
          </a>
          <a href={`mailto:${site.email}`}>email</a>
        </p>
        <p class="profile-name">{site.name}</p>
      </div>
    </div>
  </div>
</dialog>

<style>
  :global(html:has(.profile[open])) {
    overflow: hidden;
  }

  .post-author {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1.25rem;
    font-size: 0.85rem;
    color: var(--fg);
  }

  /* ponytail: crops the head out of the about photo with CSS; swap for a real square avatar file if one exists */
  .post-avatar {
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid var(--border);
    padding: 0;
    cursor: pointer;
    background: var(--photo) 0% 22% / 214% auto no-repeat;
  }

  .post-avatar:hover,
  .post-avatar:focus-visible {
    border-color: var(--accent);
    outline: none;
  }

  .profile {
    width: min(36rem, calc(100vw - 2rem));
    margin: auto; /* Tailwind's reset zeroes it, which pins the dialog top-left */
    padding: 1.4rem 1.1rem 1.1rem;
    overflow: visible;
    font: 0.8rem/1.65 var(--font-mono);
    color: var(--fg-muted);
    background: var(--body-bg);
    border: 1px solid var(--syn-type);
    border-radius: 8px;
  }

  /* Windows 3.1-style "zoom rect": a bare outline grows in steps, then the real window appears */
  :global(.profile-zoom) {
    position: fixed;
    z-index: 100;
    pointer-events: none;
    border: 1px solid var(--syn-type);
  }

  .profile::backdrop {
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .profile p {
    margin: 0;
  }

  .profile-title {
    position: absolute;
    top: -0.6rem;
    left: 0.7rem;
    padding: 0 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--syn-type);
    background: var(--body-bg);
  }

  .profile-close {
    position: absolute;
    top: 0.4rem;
    right: 0.6rem;
    font: inherit;
    color: var(--fg-faint);
    background: none;
    border: none;
    cursor: pointer;
  }

  .profile-close:hover,
  .profile-close:focus-visible {
    color: var(--accent);
    outline: none;
  }

  .profile-body {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .profile-photo {
    width: 45%;
    aspect-ratio: 1;
    flex-shrink: 0;
    object-fit: cover;
    border: 1px solid var(--border);
    border-radius: 6px;
  }
  /* the column is exactly as tall as the photo; the epithets hang above it and out of the dialog */
  .profile-info {
    flex: 1;
    min-width: 0;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    text-align: center;
  }
  .profile-foot {
    position: relative;
  }
  .profile-epithets {
    pointer-events: none; /* it overlaps the [x] button */
    position: absolute;
    bottom: 100%;
    left: 0;
    right: 0;
    margin: 0 0 0.6rem;
    padding: 0;
    list-style: none;
    font-size: 0.75rem;
    line-height: 1.9;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--fg);
  }
  .profile .profile-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 2ch;
  }
  .profile .profile-name {
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg);
  }
  .profile-links a {
    color: var(--accent);
    text-decoration: none;
  }
  .profile-links a:hover {
    text-decoration: underline;
  }
</style>

<script>
  import { onPageLoad } from '../../utils/page';

  onPageLoad(() => {
    const dialog = document.getElementById('profile') as HTMLDialogElement | null;
    if (!dialog) return;
    const trigger = document.getElementById('profile-open');
    let zooming = false;
    trigger?.addEventListener('click', () => {
      if (zooming) return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return dialog.showModal();
      // measure the final box; nothing paints between show and close
      dialog.showModal();
      const to = dialog.getBoundingClientRect();
      dialog.close();
      const from = trigger.getBoundingClientRect();
      const box = document.body.appendChild(document.createElement('div'));
      box.className = 'profile-zoom';
      zooming = true;
      const steps = 8;
      let i = 1;
      // setInterval, not CSS transitions: the jumpy steps are the point
      const tick = setInterval(() => {
        if (i > steps) {
          clearInterval(tick);
          box.remove();
          zooming = false;
          dialog.showModal();
          return;
        }
        const t = i++ / steps;
        const at = (a: number, b: number) => `${a + (b - a) * t}px`;
        Object.assign(box.style, {
          left: at(from.left, to.left),
          top: at(from.top, to.top),
          width: at(from.width, to.width),
          height: at(from.height, to.height),
        });
      }, 35);
    });
    // close on backdrop click: the click lands on the dialog element itself, outside its panel box
    dialog.addEventListener('click', (e) => {
      const r = dialog.getBoundingClientRect();
      if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) dialog.close();
    });
  });
</script>
