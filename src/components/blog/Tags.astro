---
interface Props {
  tags?: string[];
}

const { tags = [] } = Astro.props;
---

{tags.length > 0 && (
  <div class="post-tags">
    {tags.map((tag) => <span class="post-tag">{tag}</span>)}
  </div>
)}

<style>
  .post-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; font: 0.72rem var(--font-mono); }
  .post-tag {
    padding: 0.15rem 0.55rem;
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border: 1px solid var(--border);
    border-radius: 4px;
  }
</style>
