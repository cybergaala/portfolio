---
---

<header>
  <nav id="mainNav">
    <div class="bar page-container">
      <a href="/" class="nav-logo" aria-label="Edgar Mejía, home"><span class="accent">~/home</span><span class="cursor" aria-hidden="true"></span></a>
      <ul class="nav-links">
        <li><a href="/#contact" data-sec="contact" class="say-hi">[ contact ]</a></li>
      </ul>
      <button id="theme-toggle" aria-label="Toggle theme">
        <span class="icon-moon">[dark]</span>
        <span class="icon-sun">[light]</span>
      </button>
    </div>
  </nav>
</header>

<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    font-family: var(--font-mono);
    border-bottom: 1px solid transparent;
    transition: background-color 0.2s, border-color 0.2s;
  }

  nav.nav-scrolled {
    background-color: color-mix(in srgb, var(--body-bg) 85%, transparent);
    backdrop-filter: blur(8px);
    border-bottom-color: var(--border);
  }

  .bar { display: flex; align-items: center; height: 56px; }

  .nav-logo {
    display: flex;
    align-items: center;
    margin-right: auto;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--fg);
    text-decoration: none;
  }

  .accent { color: var(--accent); }
  .faint { color: var(--fg-faint); font-weight: 400; }

  .cursor { width: 0.5em; height: 1.05em; margin-left: 0.3em; background: var(--accent); opacity: 0; transition: opacity 0.15s; }
  .nav-logo:hover .cursor { opacity: 1; }

  .nav-links { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: 1.5rem; }

  .nav-links a {
    font-size: 0.8rem;
    color: var(--fg-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-links a:hover { color: var(--fg); }
  .nav-links a.active { color: var(--accent); }

  .nav-links a.say-hi { color: var(--accent); }
  .nav-links a.say-hi:hover { color: var(--fg); }

  #theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 32px;
    margin-left: 1.25rem;
    padding: 0;
    font: 0.8rem var(--font-mono);
    color: var(--fg-faint);
    background: none;
    border: none;
    cursor: pointer;
    flex-shrink: 0;
    transition: color 0.2s;
  }

  #theme-toggle:hover { color: var(--fg); }

  .icon-sun { display: none; }
  .icon-moon { display: block; }
  :global(html.dark) .icon-sun { display: block; }
  :global(html.dark) .icon-moon { display: none; }

</style>

<script>
  // Scroll handler always looks up a fresh DOM reference so it works
  // correctly after ViewTransitions swaps the page body.
  window.addEventListener('scroll', () => {
    const nav = document.getElementById('mainNav');
    if (nav) nav.classList.toggle('nav-scrolled', window.scrollY > 40);
  });

  let secObserver: IntersectionObserver | undefined;

  function initNavState() {
    // every section link on the page: [ contact ] here and the home page's section timeline
    const links = document.querySelectorAll<HTMLAnchorElement>('a[data-sec]');
    const setActive = (id: string) => links.forEach((a) => a.classList.toggle('active', a.dataset.sec === id));

    secObserver?.disconnect();

    if (location.pathname.startsWith('/blog')) return setActive('writing');
    setActive('');
    if (location.pathname !== '/') return;
    secObserver = new IntersectionObserver((entries) => {
      entries.forEach((en) => { if (en.isIntersecting) setActive(en.target.id); });
    }, { rootMargin: '-40% 0px -55% 0px' });
    ['hero', 'projects', 'writing', 'experience', 'contact'].forEach((id) => {
      const el = document.getElementById(id);
      if (el) secObserver!.observe(el);
    });
  }

  document.addEventListener('astro:page-load', initNavState);

  const overToggle = (e: MouseEvent) => {
    const r = document.getElementById('theme-toggle')?.getBoundingClientRect();
    return !!r && e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
  };

  // During a view transition Chrome hit-tests the whole page as <html>, so the
  // theme toggle never sees a click there; forward clicks that land on it.
  document.addEventListener('click', (e) => {
    if (e.target === document.documentElement && overToggle(e)) document.getElementById('theme-toggle')!.click();
  });

  // fast repeated clicks are double/triple clicks: keep them from selecting the text nearby
  document.addEventListener('mousedown', (e) => {
    if (overToggle(e)) e.preventDefault();
  });

  function initHeader() {
    const mainNav = document.getElementById('mainNav');
    const toggleBtn = document.getElementById('theme-toggle');
    const html = document.documentElement;

    // Re-apply scroll class immediately in case the page loaded while scrolled.
    if (mainNav) mainNav.classList.toggle('nav-scrolled', window.scrollY > 40);

    if (!toggleBtn) return;

    const DURATION = 650;
    // the active circle reveal: a click while it's active reverses it instead of starting over,
    // so fast clicking never stacks transitions. `dark` is the theme the last click asked for.
    let trans: any;
    let dark = false;

    const setTheme = (dark: boolean) => {
      html.classList.toggle('dark', dark);
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    };

    toggleBtn.addEventListener('click', () => {
      if (trans) {
        dark = !dark;
        return;
      }

      const toDark = (dark = !html.classList.contains('dark'));
      if (!('startViewTransition' in document) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
        return setTheme(toDark);
      }

      const rect = toggleBtn.getBoundingClientRect();
      // Chrome Android draws view transitions in a box that starts behind the
      // top URL bar (100lvh), while rect is measured from the visible viewport.
      const lvhProbe = document.createElement('div');
      lvhProbe.style.cssText = 'position:fixed;top:0;height:100lvh;visibility:hidden';
      document.body.append(lvhProbe);
      const boxH = lvhProbe.offsetHeight;
      lvhProbe.remove();
      const x = rect.left + rect.width / 2;
      const y = rect.top + rect.height / 2 + Math.max(0, boxH - window.innerHeight);
      // grow only to the farthest corner, so the whole animation is visible movement
      const r = Math.hypot(Math.max(x, window.innerWidth - x), Math.max(y, boxH - y));
      const circles = [`circle(0px at ${x}px ${y}px)`, `circle(${r}px at ${x}px ${y}px)`];
      html.style.setProperty('--theme-x', `${x}px`);
      html.style.setProperty('--theme-y', `${y}px`);

      html.dataset.themeTransition = 'true';
      const t = (trans = (document as any).startViewTransition(() => setTheme(toDark)));
      let anim: Animation | undefined;
      t.ready.then(() => {
        if (trans !== t) return;
        anim = html.animate(
          { clipPath: toDark ? circles : circles.reverse() },
          {
            duration: DURATION,
            easing: 'cubic-bezier(0.4, 0, 0.2, 1)',
            fill: 'forwards',
            pseudoElement: toDark ? '::view-transition-new(root)' : '::view-transition-old(root)',
          },
        );
        // Driven frame by frame on the main thread: a playing clip-path animation runs off-thread,
        // and reversing it there drew one more frame forward before snapping back (a visible jolt).
        anim!.pause();
        let elapsed = 0;
        let last: number | undefined;
        const step = (now: number) => {
          if (trans !== t) return;
          elapsed += (now - (last ?? now)) * (dark === toDark ? 1 : -1);
          last = now;
          if (elapsed >= DURATION) {
            // free the toggle right away, not when `finished` settles a few frames later
            trans = undefined;
            anim!.finish();
          } else if (elapsed <= 0 && dark !== toDark) {
            // reversed back to where it started: restore the old theme and end without a flash
            trans = undefined;
            setTheme(!toDark);
            t.skipTransition();
          } else {
            anim!.currentTime = elapsed;
            requestAnimationFrame(step);
          }
        };
        requestAnimationFrame(step);
      }, () => {});
      t.finished.finally(() => {
        // the fill keeps the end state until the transition is gone; left on <html> it would clip
        // the next transition's fresh snapshot too (e.g. the light one, to an empty dark screen)
        anim?.cancel();
        if (trans === t) trans = undefined;
        // a newer transition may already be running and still needs its theme styles
        if (!trans) delete html.dataset.themeTransition;
      });
    });
  }

  document.addEventListener('astro:page-load', initHeader);
</script>
