---
---

<header>
  <nav id="mainNav">
    <div class="bar page-container">
      <a href="/" class="nav-logo" aria-label="Edgar Mejía, home"><span class="accent">edgar</span>@sv<span class="faint">:~$</span><span class="cursor" aria-hidden="true"></span></a>
      <ul class="nav-links">
        <li><a href="/#projects" data-sec="projects">./projects</a></li>
        <li><a href="/#experience" data-sec="experience">./experience</a></li>
        <li><a href="/blog" data-sec="blog">./blog</a></li>
        <li><a href="/#contact" data-sec="contact" class="say-hi">[ say hi ]</a></li>
      </ul>
      <button id="theme-toggle" aria-label="Toggle theme">
        <span class="icon-moon">[dark]</span>
        <span class="icon-sun">[light]</span>
      </button>
      <button id="menu-btn" aria-label="Menu" aria-expanded="false"></button>
    </div>
  </nav>
</header>

<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    font-family: var(--font-mono);
    border-bottom: 1px solid transparent;
    transition: background-color 0.2s, border-color 0.2s;
  }

  nav.nav-scrolled, nav.open {
    background-color: color-mix(in srgb, var(--body-bg) 85%, transparent);
    backdrop-filter: blur(8px);
    border-bottom-color: var(--border);
  }

  .bar { display: flex; align-items: center; height: 56px; }

  .nav-logo {
    display: flex;
    align-items: center;
    margin-right: auto;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--fg);
    text-decoration: none;
  }

  .accent { color: var(--accent); }
  .faint { color: var(--fg-faint); font-weight: 400; }

  .cursor { width: 0.5em; height: 1.05em; margin-left: 0.3em; background: var(--accent); opacity: 0; transition: opacity 0.15s; }
  .nav-logo:hover .cursor { opacity: 1; }

  .nav-links { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: 1.5rem; }

  .nav-links a {
    font-size: 0.8rem;
    color: var(--fg-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-links a:hover { color: var(--fg); }
  .nav-links a.active { color: var(--accent); }
  .nav-links a.say-hi { color: var(--accent); }
  .nav-links a.say-hi:hover { color: var(--fg); }

  #theme-toggle, #menu-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 32px;
    margin-left: 1.25rem;
    padding: 0;
    font: 0.8rem var(--font-mono);
    color: var(--fg-faint);
    background: none;
    border: none;
    cursor: pointer;
    flex-shrink: 0;
    transition: color 0.2s;
  }

  #theme-toggle:hover, #menu-btn:hover { color: var(--fg); }

  .icon-sun { display: none; }
  .icon-moon { display: block; }
  :global(html.dark) .icon-sun { display: block; }
  :global(html.dark) .icon-moon { display: none; }

  #menu-btn { display: none; margin-left: 0.75rem; }
  #menu-btn::before { content: "[menu]"; }
  nav.open #menu-btn::before { content: "[close]"; }

  @media (max-width: 720px) {
    #theme-toggle { margin-left: 0; }
    #menu-btn { display: flex; }

    .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding: 0.5rem 1rem 1.25rem;
      background: var(--body-bg);
      border-bottom: 1px solid var(--border);
    }

    nav.open .nav-links { display: flex; }
    .nav-links a { display: block; padding: 0.55rem 0; font-size: 1rem; }
  }
</style>

<script>
  // Scroll handler always looks up a fresh DOM reference so it works
  // correctly after ViewTransitions swaps the page body.
  window.addEventListener('scroll', () => {
    const nav = document.getElementById('mainNav');
    if (nav) nav.classList.toggle('nav-scrolled', window.scrollY > 40);
  });

  let secObserver: IntersectionObserver | undefined;

  function initNavState() {
    const nav = document.getElementById('mainNav');
    const links = document.querySelectorAll<HTMLAnchorElement>('.nav-links a');
    const setActive = (id: string) => links.forEach((a) => a.classList.toggle('active', a.dataset.sec === id));

    nav?.classList.remove('open');
    document.getElementById('menu-btn')?.setAttribute('aria-expanded', 'false');
    secObserver?.disconnect();

    if (location.pathname.startsWith('/blog')) return setActive('blog');
    setActive('');
    if (location.pathname !== '/') return;
    secObserver = new IntersectionObserver((entries) => {
      entries.forEach((en) => { if (en.isIntersecting) setActive(en.target.id); });
    }, { rootMargin: '-40% 0px -55% 0px' });
    ['projects', 'experience', 'contact'].forEach((id) => {
      const el = document.getElementById(id);
      if (el) secObserver!.observe(el);
    });
  }

  document.addEventListener('astro:page-load', initNavState);

  // event delegation so the handler survives ViewTransitions body swaps
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const nav = document.getElementById('mainNav');
    if (!nav) return;
    if (t.closest('#menu-btn')) {
      const open = nav.classList.toggle('open');
      document.getElementById('menu-btn')!.setAttribute('aria-expanded', String(open));
    } else if (t.closest('.nav-links a')) {
      nav.classList.remove('open');
    }
  });

  function initHeader() {
    const mainNav = document.getElementById('mainNav');
    const toggleBtn = document.getElementById('theme-toggle');
    const html = document.documentElement;

    // Re-apply scroll class immediately in case the page loaded while scrolled.
    if (mainNav) mainNav.classList.toggle('nav-scrolled', window.scrollY > 40);

    if (!toggleBtn) return;

    const DURATION = 650;
    let transitionGen = 0;
    let transitionEndTime = 0;
    let animStartTime = 0;
    let animStartR = 0;
    let animEndR = 0;
    let animDur = DURATION;

    function startThemeTransition(applyFn: () => void, interrupted: boolean) {
      const gen = ++transitionGen;
      if (interrupted) {
        html.dataset.themeInterrupted = 'true';
      } else {
        delete html.dataset.themeInterrupted;
      }
      html.dataset.themeTransition = 'true';

      const trans = (document as any).startViewTransition(applyFn);
      trans.finished.finally(() => {
        if (transitionGen === gen) {
          transitionEndTime = 0;
          delete html.dataset.themeTransition;
          delete html.dataset.themeInterrupted;
        }
      });
    }

    toggleBtn.addEventListener('click', () => {
      const now = Date.now();
      const rect = toggleBtn.getBoundingClientRect();
      const cx = Math.round(rect.left + rect.width / 2);
      const cy = Math.round(rect.top + rect.height / 2);
      html.style.setProperty('--theme-x', cx + 'px');
      html.style.setProperty('--theme-y', cy + 'px');

      if (now < transitionEndTime) {
        const elapsed = now - animStartTime;
        const t = Math.min(elapsed / animDur, 1);
        const currentR = animStartR + (animEndR - animStartR) * t;
        const newEndR = animEndR > animStartR ? 0 : 200;
        const newDur = Math.max(80, (Math.abs(newEndR - currentR) / 200) * DURATION);

        html.style.setProperty('--theme-r-interrupt', currentR.toFixed(2) + 'vmax');
        html.style.setProperty('--theme-dur-interrupt', newDur + 'ms');

        const isDarkNow = html.classList.contains('dark');
        animStartTime = now;
        animStartR = currentR;
        animEndR = newEndR;
        animDur = newDur;
        transitionEndTime = now + newDur + 50;

        startThemeTransition(() => {
          if (isDarkNow) {
            html.classList.remove('dark');
            localStorage.setItem('theme', 'light');
          } else {
            html.classList.add('dark');
            localStorage.setItem('theme', 'dark');
          }
        }, true);
        return;
      }

      const isDark = html.classList.contains('dark');

      if (!('startViewTransition' in document)) {
        if (isDark) {
          html.classList.remove('dark');
          localStorage.setItem('theme', 'light');
        } else {
          html.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        }
        return;
      }

      animStartTime = now;
      animStartR = isDark ? 200 : 0;
      animEndR = isDark ? 0 : 200;
      animDur = DURATION;
      transitionEndTime = now + DURATION + 50;

      startThemeTransition(() => {
        if (isDark) {
          html.classList.remove('dark');
          localStorage.setItem('theme', 'light');
        } else {
          html.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        }
      }, false);
    });
  }

  document.addEventListener('astro:page-load', initHeader);
</script>
