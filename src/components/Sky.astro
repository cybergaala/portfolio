---
// ASCII star field; seeded so every build renders the same sky.
// The parent needs `position: relative` and should keep its content above (position: relative too).
interface Props {
  count?: number;
  seed?: number;
  class?: string;
}

const { count = 70, seed: start = 7, class: className } = Astro.props;

let seed = start;
const rand = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const stars = Array.from({ length: count }, () => ({
  char: ['.', '.', '.', '*', '+', "'"][Math.floor(rand() * 6)],
  x: (rand() * 100).toFixed(1),
  y: (rand() * 100).toFixed(1),
  twinkle: rand() < 0.3,
  delay: (rand() * 4).toFixed(1),
  red: rand() < 0.12,
}));
---

<div class:list={['sky', className]} aria-hidden="true">
  {stars.map((st) => (
    <span class:list={{ twinkle: st.twinkle, red: st.red }} style={`left:${st.x}%;top:${st.y}%;--delay:${st.delay}s`}>
      {st.char}
    </span>
  ))}
</div>

<style>
  .sky {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    font: 0.85rem var(--font-mono);
    color: var(--fg-faint);
  }
  .sky span {
    position: absolute;
    line-height: 1;
    opacity: 0.55;
  }
  .sky .red {
    color: var(--accent);
    opacity: 0.8;
  }

  @media (prefers-reduced-motion: no-preference) {
    .sky .twinkle {
      animation: twinkle 3.5s ease-in-out var(--delay) infinite;
    }
  }

  @keyframes twinkle {
    50% {
      opacity: 0.1;
    }
  }
</style>
