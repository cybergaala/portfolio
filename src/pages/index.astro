---
import Layout from "../layouts/Layout.astro";
import Sky from "../components/Sky.astro";
import PostRow from '../components/blog/PostRow.astro';
import { getPosts } from '../utils/blog';
import { experience, type Role } from '../data/experience';
import { projects } from '../data/projects';
// ANSI half-block art, generated with scripts/ascii-art.py --ansi; the earlier ASCII take covers it by default
// and pressing reveals it (holding the lens swaps which one is the default, see initArtLens)
import art from '../data/hero-art.json';
// fastfetch color blocks laid out like a terminal's 8 normal + 8 bright colors, drawn from the theme tokens
// so they follow light/dark; the bright row is each color mixed with white
const palette = ['var(--syn-com)', 'var(--syn-str)', '#3ecf6e', 'var(--syn-num)', 'var(--syn-type)', 'var(--syn-kw)', 'var(--accent)', 'var(--fg)'];
const paletteRows = [palette, palette.map((c) => `color-mix(in oklab, ${c} 65%, white)`)];

const posts = (await getPosts('en')).slice(0, 5);

const email = 'contact@edgarmejia.com';

// fastfetch-style hero; keys follow fastfetch's module names
const fetch: [string, string][] = [
  ['User', 'Edgar Mejía, mobile developer'],
  ['OS', 'iOS · Android'],
  ['Kernel', 'Swift · Kotlin · Flutter'],
  ['Packages', 'Jetpack Compose, Firebase, Clean Architecture'],
  ['Host', 'PBS El Salvador (remote)'],
  ['Uptime', '8+ years shipping apps'],
  ['Locale', 'es_SV, en_US'],
  ['CPU', 'Coca-Cola, never coffee'],
  ['Memory', 'girl dad, one cat'],
];

// lazygit-style commit hashes, derived from the company name so they never change
const hash = (str: string) => {
  let h = 5381;
  for (const c of str) h = ((h * 33) ^ c.charCodeAt(0)) >>> 0;
  return h.toString(16).padStart(8, '0').slice(0, 7);
};

// lazygit graph: one string per row, a rail every 2 chars (main, a side branch, life).
// The side rail is freelance (2019-22) and later fullstack (2023-24); `side` picks its color.
const role = Object.fromEntries(experience.map((e) => [e.id, e]));
type Label = [string, 'head' | 'branch' | 'tag'];
type Commit = { graph: string; side?: string; labels?: Label[]; msg?: string; date?: string; desc?: string; job?: Role; parents?: [string, string] };

const jobMsg = (j: Role) => `feat: ${j.role} @ ${j.company}${j.client ? ` (${j.client})` : ''}`;
const FULL = 'r1', FREE = 'r3';

const commits: Commit[] = ([
  { graph: '⏣─╮ │', side: FULL, labels: [['HEAD -> main', 'head']], msg: "Merge branch 'fullstack' into main", date: 'Apr 2024', desc: 'Wrapped up the ERP work and went back to mobile full time.', parents: ['pbs', 'thinkforward'] },
  { graph: '◯ │ │', side: FULL, labels: [['v3.0', 'tag']], job: role.pbs },
  { graph: '│ │ ◯', side: FULL, labels: [['life', 'branch']], msg: 'feat(life): girl dad 👧🏻', desc: 'Best release so far. Zero patience for loading spinners.' },
  { graph: '◯ │ │', side: FULL, labels: [['v2.1', 'tag']], job: role.serfinsa },
  { graph: '│ ◯ │', side: FULL, labels: [['fullstack', 'branch']], job: role.thinkforward },
  { graph: '◯─╯ │', side: FULL, labels: [['v2.0', 'tag']], job: role.hightech },
  { graph: '⏣─╮ │', side: FREE, msg: "Merge branch 'freelance' into main", date: 'Jun 2022', desc: 'Freelance and Creativa wrap up; mobile becomes the main branch.', parents: ['aes-analyst', 'freelance-ios'] },
  { graph: '◯ │ │', side: FREE, job: role.aeroman },
  { graph: '◯ │ │', side: FREE, job: role['aes-analyst'] },
  { graph: '│ ◯ │', side: FREE, labels: [['freelance', 'branch']], job: role['freelance-ios'] },
  { graph: '│ │ ◯', side: FREE, msg: 'feat(life): adopt a cat 🐱', desc: 'Chief keyboard inspector. Reviews every PR by walking on it.' },
  { graph: '◯ │ │', side: FREE, job: role['aes-python'] },
  { graph: '│ ◯ │', side: FREE, job: role['freelance-android'] },
  { graph: '◯─╯ │', side: FREE, labels: [['v1.0', 'tag']], job: role.creativa },
  { graph: '◯   │', job: role.betterride },
  { graph: '◯───╯', side: 'r2', labels: [['v0.1', 'tag']], msg: 'init: hello, world', date: 'a long time ago', desc: 'First line of code. Probably a missing semicolon.' },
] as Commit[]).map((c) => (c.job ? { ...c, msg: jobMsg(c.job), date: c.job.period, desc: c.job.desc } : c));

// color each graph char by the rail it belongs to
const rail = (i: number, c: Commit) => (i === 0 ? 'r0' : i <= 2 ? (c.side ?? 'r1') : 'r2');

// Draw each row's graph as SVG instead of box-drawing glyphs: font glyphs leave gaps between
// rows and around ◯, while SVG cells span the full row height so rails always connect.
const CW = 6.9, CH = 14, CX = CW / 2, CY = CH / 2, R = 2.4;
const line = (x1: number, y1: number, x2: number, y2: number) => `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}"/>`;
const graphSvg = (i: number) => {
  const c = commits[i];
  const chars = [...c.graph];
  const at = (row: number, col: number) => [...(commits[row]?.graph ?? '')][col] ?? ' ';
  const cells = chars.map((ch, col) => {
    let d = '';
    if (ch === '│') d = line(CX, 0, CX, CH);
    else if (ch === '─') d = line(0, CY, CW, CY);
    else if (ch === '╮') d = line(0, CY, CX, CY) + line(CX, CY, CX, CH);
    else if (ch === '╯') d = line(0, CY, CX, CY) + line(CX, 0, CX, CY);
    else if (ch === '◯' || ch === '⏣') {
      if ('│◯⏣╮'.includes(at(i - 1, col))) d += line(CX, 0, CX, CY - R);
      if ('│◯⏣╯'.includes(at(i + 1, col))) d += line(CX, CY + R, CX, CH);
      if (chars[col + 1] === '─') d += line(CX + R, CY, CW, CY);
      d += ch === '◯'
        ? `<circle cx="${CX}" cy="${CY}" r="${R}"/>`
        : `<polygon points="${[0, 60, 120, 180, 240, 300].map((a) => `${(CX + R * Math.cos((a * Math.PI) / 180)).toFixed(2)},${(CY + R * Math.sin((a * Math.PI) / 180)).toFixed(2)}`).join(' ')}"/>`;
    }
    return d && `<g class="${rail(col, c)}" transform="translate(${col * CW} 0)">${d}</g>`;
  });
  return `<svg viewBox="0 0 ${chars.length * CW} ${CH}" style="width:${chars.length * 0.69}em">${cells.join('')}</svg>`;
};

// 'Mar 2024 — Present' -> '2024-03 → now'
const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const shortDate = (d: string) => {
  const [m, y] = d.trim().split(' ');
  return m === 'Present' ? 'now' : `${y}-${String(months.indexOf(m) + 1).padStart(2, '0')}`;
};
const shortPeriod = (p: string) => p.split('—').map(shortDate).join(' → ');

// `ls -l` columns for projects and posts
const lsDate = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).replace(',', '');
const lsSize = (bytes: number) => `${(bytes / 1024).toFixed(1)}K`;
const linkTarget = (url: string) => url.replace(/^https?:\/\//, '');

// open on the current job instead of the merge commit
const selected = commits.findIndex((c) => c.job?.current);
---

<Layout
  title="Edgar Mejía — Mobile Developer"
  description="Edgar Mejía, mobile developer from El Salvador building iOS, Android and Flutter apps."
  lang="en"
>
  <section id="hero" class="hero">
    <Sky count={140} />
    <div class="page-container">
      <h1 class="sr-only">Edgar Mejía — mobile developer in San Salvador</h1>
      <div class="term reveal">
        <div class="term-body mono">
          <p class="term-cmd"><span class="path">~</span> $ fastfetch</p>
          <div class="ff">
            <div class="ff-art-wrap swapped" aria-hidden="true">
              {/* the pre only sizes the 128x43 grid (one plain span per row); the ANSI pixels are painted
                  once into the canvas, since 4k colored spans made every theme switch restyle them all */}
              <pre class="ff-art" set:html={art.map((row) => `<span>${row.map((run) => run[2]).join('')}</span>`).join('\n')} />
              <canvas class="ff-ansi" width="128" height={art.length * 2} data-art={JSON.stringify(art)}></canvas>
              <canvas class="ff-ascii" data-take="dark"></canvas>
              <canvas class="ff-ascii" data-take="light"></canvas>
            </div>
            <div class="ff-info">
              <p class="ff-title"><span class="ff-key">user</span>@<span class="ff-key">localhost</span></p>
              <p class="ff-rule" aria-hidden="true">------------------</p>
              {fetch.map(([k, v]) => <p><span class="ff-key">{k}</span>: {v}</p>)}
              <p><span class="ff-key">Status</span>: <span class="dot" aria-hidden="true"></span> open to new projects</p>
              {paletteRows.map((row) => <p class="ff-colors" aria-hidden="true">{row.map((c) => <span style={`background:${c}`}></span>)}</p>)}
            </div>
          </div>
          <p class="term-cmd"><span class="path">~</span> $ ls ~/links</p>
          <p class="ff-links">
            <a href="#contact">say-hi.sh</a>
            <a href="https://github.com/cybergaala" target="_blank" rel="noopener">github ↗</a>
            <a href="https://www.linkedin.com/in/mejia-edgar/" target="_blank" rel="noopener">linkedin ↗</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <nav class="history mono" aria-label="Sections">
    <ol>
      <li><a href="#hero" data-sec="hero">Home</a></li>
      <li><a href="#projects" data-sec="projects">Projects</a></li>
      <li><a href="#writing" data-sec="writing">Writing</a></li>
      <li><a href="#experience" data-sec="experience">Experience</a></li>
      <li><a href="#contact" data-sec="contact">Contact</a></li>
    </ol>
  </nav>

  <section id="projects" class="section">
      <div class="page-container">
        <header class="sec-head reveal">
          <p class="cmd">$ ls -l ~/projects</p>
          <h2 class="sec-title">Projects</h2>
        </header>
        <div class="ls ls-dirs mono reveal">
          <p class="ls-total">total {projects.length}</p>
          {projects.length === 0 && <p class="ls-wip"><span class="ls-wip-tag">[WIP]</span> # still polishing these, check back soon</p>}
          {projects.map((p) => {
            const link = p.href ?? p.code;
            return (
              <a href={link ?? '#'} class="ls-row" {...(link ? { target: '_blank', rel: 'noopener' } : {})}>
                <span class="ls-perm">{link ? 'lrwxr-xr-x' : 'drwxr-xr-x'}</span>
                <span class="ls-owner">dev</span>
                <span class="ls-group">{p.tags[0].toLowerCase()}</span>
                <span class="ls-size">4.0K</span>
                <span class="ls-name dir">{link ? <>{p.title} <span class="ls-arrow">-&gt; {linkTarget(link)}</span></> : `${p.title}/`}</span>
                <span class="ls-note"># {p.desc}</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>

  {posts.length > 0 && (
    <section id="writing" class="section">
      <div class="page-container">
        <header class="sec-head reveal">
          <p class="cmd">$ ls -lt ~/blog | head -5</p>
          <h2 class="sec-title">Writing</h2>
        </header>
        <div class="ls mono reveal">
          {posts.map((post) => <PostRow post={post} />)}
        </div>
        <a href="/blog" class="more mono">all posts →</a>
      </div>
    </section>
  )}

  <section id="experience" class="section">
    <div class="page-container">
      <header class="sec-head reveal">
        <p class="cmd">$ lazygit</p>
        <h2 class="sec-title">Experience</h2>
      </header>
      <div class="lg mono reveal" data-lazygit>
        <div class="lg-panel lg-commits" style={`--rows:${commits.length}`}>
          <span class="lg-title">[4] Commits</span>
          <ul class="lg-list" role="listbox" aria-label="Experience" tabindex="0">
            {commits.map((c, i) => (
              <li role="option" aria-selected={i === selected ? 'true' : 'false'} class:list={{ job: c.job }} data-i={i}>
                <span class="lg-hash">{hash(c.msg!)}</span>
                <span class="lg-graph" aria-hidden="true" set:html={graphSvg(i)} />
                <span class="lg-msg">
                  {c.labels?.map(([t, k]) => <span class={`lg-label ${k}`}>{t}</span>)}
                  {c.job
                    ? <><span class="lg-co">{c.job.client ?? c.job.company}</span> <span class="lg-role">{c.job.role}</span></>
                    : <span class="lg-note">{c.msg}</span>}
                </span>
                {c.job && <span class="lg-date">{shortPeriod(c.job.period)}</span>}
              </li>
            ))}
          </ul>
          <span class="lg-count"><span data-pos>{selected + 1}</span> of {commits.length}</span>
        </div>

        <div class="lg-panel lg-patch">
          <span class="lg-title">Patch</span>
          {commits.map((c, i) => (
            <div class="lg-detail" data-detail={i} hidden={i !== selected}>
              <p><span class="lg-hash">commit {hash(c.msg!)}</span>{c.labels && <span> ({c.labels.map(([t]) => t).join(', ')})</span>}</p>
              {c.parents && <p>{'Merge:  '}{c.parents.map((id) => hash(jobMsg(role[id]))).join(' ')}</p>}
              <p>Author: &lt;{email}&gt;</p>
              {c.date && <p>{'Date:   '}{c.date}</p>}
              <p class="lg-body">{c.msg}</p>
              {c.job && <p class="lg-body lg-desc">{c.job.meta}</p>}
              {c.desc && <p class="lg-body lg-desc">{c.desc}</p>}
              {c.job && c.job.tags.length > 0 && (
                <>
                  <p class="lg-file">--- a/stack.txt<br />+++ b/stack.txt</p>
                  {c.job.tags.map((t) => <p class="lg-add">+ {t}</p>)}
                </>
              )}
            </div>
          ))}
        </div>

        <p class="lg-keys">navigate: <span>↑/↓</span> <span>j/k</span> · select: <span>click</span></p>
      </div>
    </div>
  </section>

  <section id="contact" class="section">
    <div class="page-container">
      <header class="sec-head reveal">
        <p class="cmd">$ mail dev</p>
        <h2 class="sec-title">Contact</h2>
      </header>
      <div class="mail mono reveal">
        <p class="mail-note"># freelance, a full-time role, or just cats. I usually reply within a day.</p>
        <p class="mail-to"><span class="ff-key">To</span>: &lt;<button type="button" class="copy-email" data-email={email}><span class="copy-label">{email}</span></button>&gt; <span class="copy-hint">[copy]</span></p>
        <form id="contact-form" name="contact" method="POST" data-netlify="true">
          <input type="hidden" name="form-name" value="contact" />
          <div class="mail-row">
            <label class="lg-panel mail-field"><span class="lg-title">[1] From</span><input type="text" name="name" placeholder="your name" required /></label>
            <label class="lg-panel mail-field"><span class="lg-title">[2] Reply-To</span><input type="email" name="email" placeholder="you@example.com" required /></label>
          </div>
          <label class="lg-panel mail-field"><span class="lg-title">[3] Body</span><textarea name="message" rows="6" placeholder="tell me about your project..." required></textarea></label>
          <p class="lg-keys mail-keys"><button type="submit" class="mail-send">send <span>⏎</span></button> · next field: <span>tab</span></p>
        </form>
        <p id="contact-success" class="mail-ok" hidden><span class="ok">✓</span> message queued for delivery. I'll get back to you soon.</p>
      </div>
    </div>
  </section>

  <style>
    .path { color: var(--accent); }
    .branch { color: var(--syn-kw); }

    /* Hero */
    .hero { position: relative; overflow: hidden; padding: 5.5rem 0 5rem; }
    .hero > .page-container { position: relative; }


    .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

    .dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #3ecf6e; box-shadow: 0 0 0 3px rgba(62, 207, 110, 0.2); vertical-align: middle; }

    /* fastfetch */
    /* no window chrome: the output sits on the page, right under the header prompt */
    .term-body { padding: 0; font-size: 0.8rem; line-height: 1.7; color: var(--fg); }
    .term-body p { margin: 0; }
    .term-cmd { color: var(--fg-muted); }

    .ff { display: grid; grid-template-columns: auto 1fr; gap: 2rem; margin-top: 1rem; align-items: center; }
    .ff-key { color: var(--accent); font-weight: 600; }
    .ff-title { font-weight: 600; }
    .ff-rule { color: var(--fg-faint); }
    .ff-colors { display: flex; }
    .ff-colors:not(.ff-colors + .ff-colors) { margin-top: 0.75rem !important; }
    .ff-colors span { width: 1.4rem; height: 0.9rem; }

    /* 128 columns of art: shrink the glyphs so it always fits the viewport */
    .ff-art {
      font: min(8.2px, calc((100vw - 5rem) / 77)) / 1 var(--font-mono);
      letter-spacing: 0;
      user-select: none;
      margin: 0;
      color: transparent;
    }

    /* each ▀ cell is two pixels: foreground on top, background below */
    .ff-ansi { position: absolute; inset: 0; width: 100%; height: 100%; image-rendering: pixelated; }

    /* cells exactly one row tall so the half blocks stack into square pixels */
    .ff-art :global(span) { display: inline-block; height: 1em; vertical-align: top; }

    /* Hover lens: the ASCII take sits on top of the ANSI art, same 128x43 grid, and only
       shows inside a circle that follows the pointer (--x/--y set from JS) */
    @property --lens { syntax: '<length>'; inherits: true; initial-value: 0px; }

    /* the lens opens at its resting size and is shown/hidden instantly with visibility; only the
       press-and-hold growth animates. 70px matches LENS_RADIUS in initArtLens */
    .ff-art-wrap { position: relative; --lens: 70px; transition: --lens 0.35s ease-out; -webkit-touch-callout: none; }

    /* Press and hold (mouse or finger) grows the lens, starting slow and speeding up the bigger it gets
       (ease-in that keeps accelerating until the end); letting go shrinks it back with the transition above */
    .ff-art-wrap.pressing { --lens: 800px; transition: --lens 1.1s cubic-bezier(0.7, 0, 0.84, 0); }

    /* the ASCII take is drawn once into a canvas (see drawAscii): animating the mask over 3k text spans
       repainted all of them every frame and stuttered, a canvas repaints as a single bitmap */
    /* both takes are drawn up front and CSS picks one, so a theme switch doesn't redraw 5k glyphs;
       the paper is a CSS background so each canvas follows the theme too */
    :global(html.dark) .ff-ascii[data-take='light'],
    :global(html:not(.dark)) .ff-ascii[data-take='dark'] { display: none; }

    .ff-ascii {
      background: var(--body-bg);
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      -webkit-mask-image: radial-gradient(circle var(--lens) at var(--x, 50%) var(--y, 50%), #000 calc(100% - 6px), transparent 100%);
      mask-image: radial-gradient(circle var(--lens) at var(--x, 50%) var(--y, 50%), #000 calc(100% - 6px), transparent 100%);
      pointer-events: none;
      visibility: hidden;
    }

    /* set from JS, see initArtLens */
    .ff-art-wrap:is(.hovering, .pressing) .ff-ascii { visibility: visible; }

    /* swapped is the default (set in the markup): the ASCII take covers the art and the lens cuts a hole
       showing the ANSI art underneath; holding the full lens for 5s toggles it */
    /* the canvas is only painted once the font loads: until then hide the ANSI art too, so a refresh
       doesn't flash it before the ASCII default covers it */
    .ff-art-wrap:not(.ready) .ff-ansi { visibility: hidden; }

    .ff-art-wrap.swapped .ff-ascii { visibility: visible; -webkit-mask-image: none; mask-image: none; }
    .ff-art-wrap.swapped:is(.hovering, .pressing) .ff-ascii {
      -webkit-mask-image: radial-gradient(circle var(--lens) at var(--x, 50%) var(--y, 50%), transparent calc(100% - 6px), #000 100%);
      mask-image: radial-gradient(circle var(--lens) at var(--x, 50%) var(--y, 50%), transparent calc(100% - 6px), #000 100%);
    }

    .ff-links { display: flex; flex-wrap: wrap; gap: 0.4rem 2rem; }
    .ff-links a { color: var(--syn-type); text-decoration: none; }
    .ff-links a:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }

    .term-body > .term-cmd:not(:first-child) { margin-top: 1rem !important; }

    @media (max-width: 960px) {
      .ff { grid-template-columns: 1fr; gap: 1.25rem; }

      /* stacked layout: the art bleeds past the container padding and fills the screen width (128 cols ≈ 77em) */
      .ff-art-wrap { margin-inline: -1rem; }
      .ff-art { font-size: calc(100vw / 77); }
    }

    @media (max-width: 900px) {
      .hero { padding-top: 6rem; }
    }

    /* Section timeline (wide screens only) */
    .history { display: none; }

    @media (min-width: 1360px) {
      .history {
        display: block;
        position: fixed;
        top: 50%;
        left: 2rem;
        z-index: 5;
        transform: translateY(-50%);
        font-size: 0.75rem;
        transition: opacity 0.3s;
      }
    }

    /* faded when no command is running (e.g. between sections) */
    .history:not(:has(.active)) { opacity: 0.45; }

    .history ol { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--border); }
    .history li { position: relative; padding: 0.55rem 0 0.55rem 1.1rem; }

    .history li::before {
      content: "";
      position: absolute;
      left: -4.5px;
      top: 50%;
      width: 8px;
      height: 8px;
      margin-top: -4px;
      border-radius: 50%;
      background: var(--body-bg);
      border: 1px solid var(--fg-faint);
    }

    .history a { color: var(--fg-faint); text-decoration: none; white-space: nowrap; transition: color 0.2s; }
    .history a:hover { color: var(--fg); }

    /* already ran: every command before the running one */
    .history li:has(~ li .active) a { color: var(--fg-muted); }
    .history li:has(~ li .active)::before { background: var(--fg-faint); }

    /* running now */
    .history a.active { color: var(--fg); }
    .history li:has(.active)::before { background: var(--accent); border-color: var(--accent); }

    /* Sections */
    .section { padding: 5rem 0; border-top: 1px solid var(--border); }

    .ls-wip { grid-column: 1 / -1; margin: 0; color: var(--fg-faint); }
    .ls-wip-tag { color: var(--syn-num); font-weight: 600; }

    /* lazygit */
    .lg { display: grid; grid-template-columns: 1.75fr 1fr; gap: 0.6rem; font-size: 0.8rem; line-height: 1.65; }
    .lg p { margin: 0; }

    .lg-panel {
      position: relative;
      min-width: 0;
      padding: 1rem 0.9rem 1.1rem;
      border: 1px solid var(--border);
      border-radius: 8px;
    }

    /* the focused panel gets lazygit's highlighted border */
    .lg-commits:focus-within, .lg-commits:hover { border-color: var(--syn-type); }

    .lg-title, .lg-count {
      position: absolute;
      padding: 0 0.35rem;
      font-size: 0.75rem;
      background: var(--body-bg);
    }

    .lg-title { top: -0.6rem; left: 0.7rem; color: var(--fg); font-weight: 600; }
    .lg-count { bottom: -0.6rem; right: 0.7rem; color: var(--fg-faint); }
    .lg-commits:focus-within .lg-title, .lg-commits:hover .lg-title { color: var(--syn-type); }

    .lg-list { list-style: none; margin: 0; padding: 0; outline: none; }

    /* tight rows so the box-drawing rails connect like terminal cells */
    .lg-list li {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      height: 1.4em;
      padding: 0 0.4rem;
      line-height: 1.4;
      white-space: nowrap;
      cursor: pointer;
      border-radius: 3px;
    }

    .lg-list li:hover { background: var(--accent-soft); }
    .lg-list li[aria-selected="true"] { background: color-mix(in srgb, var(--syn-type) 22%, transparent); }

    .lg-hash { color: var(--syn-num); }
    .lg-graph { align-self: stretch; display: flex; }
    .lg-graph :global(svg) { height: 100%; overflow: visible; fill: none; stroke-width: 1.1; stroke-linecap: square; }
    .lg-graph :global(g) { stroke: currentColor; }
    .lg-graph :global(.r0) { color: var(--accent); }
    .lg-graph :global(.r1) { color: var(--syn-type); }
    .lg-graph :global(.r2) { color: #3ecf6e; }
    .lg-graph :global(.r3) { color: var(--syn-kw); }

    .lg-label { margin-right: 0.5em; font-weight: 600; }
    .lg-label.head { color: var(--syn-type); }
    .lg-label.branch { color: #3ecf6e; }
    .lg-label.tag { color: var(--syn-num); }
    .lg-label.tag::before { content: "#"; }
    .lg-msg { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; color: var(--fg); }
    .lg-co { font-weight: 600; color: var(--fg); }
    .lg-role { color: var(--fg-muted); }
    .lg-note { color: var(--fg-faint); }
    .lg-date { flex-shrink: 0; width: 17ch; text-align: right; color: var(--syn-type); }
    .lg-list li:not(.job) .lg-hash { opacity: 0.55; }

    .lg-detail { color: var(--fg-muted); }
    .lg-detail p { white-space: pre-wrap; }
    .lg-head { color: var(--fg-muted); }
    .lg-ok, .lg-add { color: #3ecf6e; }
    .lg-body { margin-top: 0.9rem !important; padding-left: 2rem; color: var(--fg); }
    .lg-desc { margin-top: 0.5rem !important; color: var(--fg-muted); white-space: normal; }
    .lg-file { margin-top: 1rem !important; color: var(--fg); font-weight: 600; }

    .lg-keys { grid-column: 1 / -1; margin-top: 0.6rem !important; font-size: 0.72rem; color: var(--fg-faint); }
    .lg-keys span { color: var(--syn-type); }

    /* side by side, the commit list alone sets the height; a long patch scrolls instead of growing the box */
    @media (min-width: 861px) {
      /* 55% taller than the rows need (1.4em each + panel padding and border), leaving room for the patch */
      .lg-commits { min-height: calc((var(--rows) * 1.4em + 2.1rem + 2px) * 1.55); }
      .lg-patch { contain: size; }
      .lg-detail { height: 100%; overflow-y: auto; }
    }

    @media (max-width: 860px) {
      .lg { grid-template-columns: 1fr; gap: 1.4rem; }
      .lg-keys { margin-top: 0 !important; }
    }

    /* Contact: a mail(1) prompt drawn with the same lazygit panels as Experience */
    .mail { font-size: 0.8rem; line-height: 1.65; }
    .mail p { margin: 0; }
    .mail-note { color: var(--fg-faint); }
    .mail-to { margin: 0.4rem 0 1.6rem !important; color: var(--fg-muted); }

    .copy-email { padding: 0; font: inherit; color: var(--accent); background: none; border: none; cursor: pointer; }
    .copy-email:hover { text-decoration: underline; text-underline-offset: 3px; }
    .copy-hint { color: var(--fg-faint); }
    .mail-to:has(.copy-email:hover) .copy-hint { color: var(--accent); }

    #contact-form { display: flex; flex-direction: column; gap: 1.4rem; }
    .mail-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem 0.6rem; }
    .mail-field { display: block; padding: 0.8rem 0.9rem 0.7rem; cursor: text; }
    .mail-field:focus-within { border-color: var(--syn-type); }
    .mail-field:focus-within .lg-title { color: var(--syn-type); }

    .mail-field input,
    .mail-field textarea {
      display: block;
      width: 100%;
      padding: 0;
      font: inherit;
      color: var(--fg);
      background: none;
      border: none;
      outline: none;
      resize: vertical;
      caret-color: var(--accent);
    }

    .mail-field input::placeholder,
    .mail-field textarea::placeholder { color: var(--fg-faint); }

    .mail-keys { margin-top: -0.4rem !important; }
    .mail-send { padding: 0.1rem 0.4rem; margin-left: -0.4rem; font: inherit; color: var(--fg); background: none; border: none; border-radius: 3px; cursor: pointer; }
    .mail-send:hover, .mail-send:focus-visible { background: var(--accent-soft); outline: none; }

    .mail-ok { color: var(--fg); }
    .ok { color: #3ecf6e; }

    @media (max-width: 560px) {
      .mail-row { grid-template-columns: 1fr; gap: 1.4rem; }
    }
  </style>
</Layout>

<script>
  import artAscii from '../data/hero-art.ascii.json';
  import artAsciiLight from '../data/hero-art-light.ascii.json';

  // the art's own ramp, so a scrambled cell only looks like a slightly different shade of the picture
  const SCRAMBLE_GLYPHS = '=+*#%@';
  const SCRAMBLE_MS = 1000;
  const SCRAMBLE_TICK = 80; // ms between glyph changes; every frame read as flicker
  const SCRAMBLE_BAND = 0.06; // width of the scrambling edge, as a share of the sweep; cells past it are still blank
  // stable per-cell jitter, so the front where glyphs settle is ragged instead of a straight line
  const noise = (x: number, y: number) => (((Math.sin(x * 12.9898 + y * 78.233) * 43758.5453) % 1) + 1) % 1;

  // paints the ASCII take on the same 128x43 grid as the ANSI art; each theme gets the take made for its paper.
  // progress < 1 is the scramble intro: the art is typed in from the top-left corner, and only a narrow band at the
  // leading edge shows random glyphs before they settle (scrambling the whole piece read as TV static)
  function drawAscii(canvas: HTMLCanvasElement, art: HTMLElement, progress = 1) {
    const rows = canvas.dataset.take === 'dark' ? artAscii : artAsciiLight;
    const { width, height } = art.getBoundingClientRect();
    const dpr = devicePixelRatio || 1;
    const w = Math.round(width * dpr), h = Math.round(height * dpr);
    // resizing reallocates the bitmap, so only do it when the size really changed (not on every scramble frame)
    if (canvas.width !== w || canvas.height !== h) { canvas.width = w; canvas.height = h; }
    const ctx = canvas.getContext('2d')!;
    const cw = width / 128, ch = height / rows.length;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, width, height);
    ctx.font = `${ch}px ${getComputedStyle(art).fontFamily}`;
    ctx.textBaseline = 'middle';
    rows.forEach((row, y) => {
      let x = 0;
      for (const [color, text] of row) {
        ctx.fillStyle = color || 'transparent';
        // one glyph per cell so the canvas grid can't drift from the DOM grid
        for (const c of text) {
          // diagonal sweep from the top-left corner: distance in on-screen units (a cell is 0.6 as wide as
          // it is tall), scaled so the bottom-right cell settles exactly at progress 1, after crossing the band
          const diag = (x * 0.6 + y) / (127 * 0.6 + rows.length - 1);
          const at = (diag * 0.92 + noise(x, y) * 0.08) * (1 - SCRAMBLE_BAND) + SCRAMBLE_BAND;
          const tick = Math.floor((progress * SCRAMBLE_MS) / SCRAMBLE_TICK);
          const glyph = progress >= at ? c
            : progress >= at - SCRAMBLE_BAND ? SCRAMBLE_GLYPHS[(noise(x + tick * 31, y) * SCRAMBLE_GLYPHS.length) | 0]
            : '';
          if (glyph && glyph !== ' ') ctx.fillText(glyph, x * cw, (y + 0.5) * ch);
          x++;
        }
      }
    });
  }

  // intro when the landing appears: only the take on screen animates (5k glyphs a frame is the budget)
  function scrambleAscii(wrap: HTMLElement, takes: NodeListOf<HTMLCanvasElement>, art: HTMLElement) {
    if (!wrap.classList.contains('swapped') || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const shown = [...takes].filter((c) => c.getClientRects().length);
    const start = performance.now();
    const frame = (now: number) => {
      const p = Math.min(1, (now - start) / SCRAMBLE_MS);
      shown.forEach((c) => drawAscii(c, art, p));
      if (p < 1) requestAnimationFrame(frame);
    };
    // first frame right away, in the same task as the final draw, so the finished art never flashes first
    frame(start);
  }

  // after the intro, every few seconds a few cells scramble for a moment and settle back into place
  const GLITCH_EVERY = [500, 1400]; // ms between glitches, picked at random in this range
  const GLITCH_CELLS = [5, 12]; // cells per glitch, picked at random in this range
  const GLITCH_TICKS = 8; // glyph changes before the cell settles, SCRAMBLE_TICK apart

  function glitchAscii(wrap: HTMLElement, takes: NodeListOf<HTMLCanvasElement>, art: HTMLElement) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return () => {};
    let timer: ReturnType<typeof setTimeout>;
    const schedule = () => {
      timer = setTimeout(glitch, GLITCH_EVERY[0] + Math.random() * (GLITCH_EVERY[1] - GLITCH_EVERY[0]));
    };
    const glitch = () => {
      schedule();
      const canvas = [...takes].find((c) => c.getClientRects().length);
      if (document.hidden || !wrap.classList.contains('swapped') || !canvas) return;
      const rows = canvas.dataset.take === 'dark' ? artAscii : artAsciiLight;
      const { width, height } = art.getBoundingClientRect();
      const cw = width / 128, ch = height / rows.length;
      const ctx = canvas.getContext('2d')!;
      for (let n = GLITCH_CELLS[0] + ((Math.random() * (GLITCH_CELLS[1] - GLITCH_CELLS[0] + 1)) | 0); n > 0; n--) {
        const y = (Math.random() * rows.length) | 0, x = (Math.random() * 128) | 0;
        // find the cell's glyph and color in the row's runs
        let col = 0, cell: [string, string] | undefined;
        for (const [color, text] of rows[y]) {
          if (x < col + text.length) { cell = [color, text[x - col]]; break; }
          col += text.length;
        }
        if (!cell || !cell[0] || cell[1] === ' ') continue;
        const [color, c] = cell;
        for (let t = 0; t <= GLITCH_TICKS; t++) {
          setTimeout(() => {
            ctx.clearRect(x * cw, y * ch, cw, ch);
            ctx.fillStyle = color;
            ctx.fillText(t < GLITCH_TICKS ? SCRAMBLE_GLYPHS[(Math.random() * SCRAMBLE_GLYPHS.length) | 0] : c, x * cw, (y + 0.5) * ch);
          }, t * SCRAMBLE_TICK);
        }
      }
    };
    schedule();
    return () => clearTimeout(timer);
  }

  function initLazygit() {
    const root = document.querySelector<HTMLElement>('[data-lazygit]');
    if (!root) return;
    const list = root.querySelector<HTMLElement>('.lg-list')!;
    const rows = [...list.querySelectorAll<HTMLElement>('li')];
    const details = [...root.querySelectorAll<HTMLElement>('[data-detail]')];
    const pos = root.querySelector('[data-pos]')!;
    let current = Math.max(0, rows.findIndex((r) => r.getAttribute('aria-selected') === 'true'));

    const select = (i: number) => {
      current = (i + rows.length) % rows.length;
      rows.forEach((r, j) => r.setAttribute('aria-selected', String(j === current)));
      details.forEach((d, j) => (d.hidden = j !== current));
      pos.textContent = String(current + 1);
    };

    rows.forEach((r, i) => r.addEventListener('click', () => { select(i); list.focus(); }));
    list.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'j') select(current + 1);
      else if (e.key === 'ArrowUp' || e.key === 'k') select(current - 1);
      else return;
      e.preventDefault();
    });
  }

  document.addEventListener('astro:page-load', initLazygit);

  function initReveal() {
    const els = document.querySelectorAll<HTMLElement>('.reveal');
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (en.isIntersecting) {
          en.target.classList.remove('pre');
          io.unobserve(en.target);
        }
      });
    }, { threshold: 0.12 });
    els.forEach((el) => {
      // only hide what is not already on screen, so above-the-fold content never flashes
      if (el.getBoundingClientRect().top > innerHeight * 0.9) el.classList.add('pre');
      io.observe(el);
    });
  }

  document.addEventListener('astro:page-load', initReveal);

  const LENS_RADIUS = 70;
  let lensCleanup: (() => void) | undefined;

  function initArtLens() {
    lensCleanup?.();
    const wrap = document.querySelector<HTMLElement>('.ff-art-wrap');
    if (!wrap) return;
    const takes = wrap.querySelectorAll<HTMLCanvasElement>('.ff-ascii');
    const art = wrap.querySelector<HTMLElement>('.ff-art')!;
    const ansi = wrap.querySelector<HTMLCanvasElement>('.ff-ansi')!;
    const ctx = ansi.getContext('2d')!;
    (JSON.parse(ansi.dataset.art!) as string[][][]).forEach((row, y) => {
      let x = 0;
      for (const [fg, bg, t] of row) {
        ctx.fillStyle = fg;
        ctx.fillRect(x, y * 2, t.length, 1);
        ctx.fillStyle = bg;
        ctx.fillRect(x, y * 2 + 1, t.length, 1);
        x += t.length;
      }
    });
    const redraw = () => { takes.forEach((c) => drawAscii(c, art)); wrap.classList.add('ready'); };
    // the visitor's last swap is remembered; storage can throw in private windows, then ASCII stays the default
    try { if (localStorage.getItem('hero-art') === 'ansi') wrap.classList.remove('swapped'); } catch {}
    // redraw when the font is ready or the art resizes (mobile scales it)
    let stopGlitch = () => {};
    document.fonts.ready.then(() => {
      redraw();
      scrambleAscii(wrap, takes, art);
      // start once the intro is over, so the glitches never fight the sweep
      const wait = setTimeout(() => (stopGlitch = glitchAscii(wrap, takes, art)), SCRAMBLE_MS);
      stopGlitch = () => clearTimeout(wait);
    });
    const resized = new ResizeObserver(redraw);
    resized.observe(art);
    // the press is tracked by hand: a wheel or trackpad scroll moves the art under a still pointer
    // without firing pointer events, so the last position is rechecked on every scroll
    let last: { x: number; y: number } | undefined;
    const place = () => {
      if (!last) return;
      const r = wrap.getBoundingClientRect();
      // the lens opens as soon as its circle touches the art, before the cursor itself is over it
      const dx = Math.max(r.left - last.x, 0, last.x - r.right);
      const dy = Math.max(r.top - last.y, 0, last.y - r.bottom);
      const inside = Math.hypot(dx, dy) <= LENS_RADIUS;
      wrap.classList.toggle('hovering', inside);
      if (!inside) return unpress();
      wrap.style.setProperty('--x', `${last.x - r.left}px`);
      wrap.style.setProperty('--y', `${last.y - r.top}px`);
    };
    const track = (e: PointerEvent) => {
      // no hover lens: it only opens while a mouse button or finger holds it down
      if (!wrap.classList.contains('pressing')) return;
      last = { x: e.clientX, y: e.clientY };
      place();
    };
    let hold: ReturnType<typeof setTimeout> | undefined;
    const unpress = () => { clearTimeout(hold); wrap.classList.remove('pressing'); };
    // forgetting the position keeps a later scroll from reopening the lens
    const close = () => { last = undefined; unpress(); wrap.classList.remove('hovering'); };
    // once the press has grown the lens over the whole art, 5 more seconds of holding swaps the default
    wrap.addEventListener('transitionend', (e) => {
      if (e.target !== wrap || e.propertyName !== '--lens' || !wrap.classList.contains('pressing')) return;
      hold = setTimeout(() => {
        const swapped = wrap.classList.toggle('swapped');
        try { localStorage.setItem('hero-art', swapped ? 'ascii' : 'ansi'); } catch {}
        // snap the lens shut without the shrink, so the swap doesn't flash the other art, then let it
        // inflate back to hover size with the base transition
        wrap.style.transition = 'none';
        wrap.style.setProperty('--lens', '0px');
        unpress();
        wrap.offsetWidth;
        wrap.style.transition = '';
        wrap.style.removeProperty('--lens');
      }, 5000);
    });

    // capture so the release still lands here when the pointer is let go outside the art
    wrap.addEventListener('pointerdown', (e) => { wrap.setPointerCapture(e.pointerId); wrap.classList.add('pressing'); track(e); });
    wrap.addEventListener('pointerup', close);
    wrap.addEventListener('pointercancel', close);
    // a long press on a phone would otherwise open the image/text menu
    wrap.addEventListener('contextmenu', (e) => e.preventDefault());
    document.addEventListener('pointermove', track);
    // leaving the browser window fires no pointermove, so close on the page's own leave
    const leave = close;
    document.documentElement.addEventListener('pointerleave', leave);
    addEventListener('scroll', place, { passive: true });
    lensCleanup = () => {
      stopGlitch();
      resized.disconnect();
      document.removeEventListener('pointermove', track);
      document.documentElement.removeEventListener('pointerleave', leave);
      removeEventListener('scroll', place);
    };
  }

  document.addEventListener('astro:page-load', initArtLens);

  function initContact() {
    const btn = document.querySelector<HTMLButtonElement>('.copy-email');
    btn?.addEventListener('click', async () => {
      const label = btn.querySelector('.copy-label')!;
      const email = btn.dataset.email!;
      try { await navigator.clipboard.writeText(email); label.textContent = 'copied ✓'; }
      catch { location.href = `mailto:${email}`; return; }
      setTimeout(() => (label.textContent = email), 1600);
    });

    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const success = document.getElementById('contact-success') as HTMLElement | null;
    if (!form || !success) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new URLSearchParams(new FormData(form) as unknown as Record<string, string>);
      await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: data.toString() });
      form.hidden = true;
      success.hidden = false;
    });
  }

  document.addEventListener('astro:page-load', initContact);
</script>
