---
import Layout from "../layouts/Layout.astro";
import { getCollection } from 'astro:content';
import { experience } from '../data/experience';
import { projects } from '../data/projects';

const posts = (await getCollection('blog', ({ id, data }) => id.startsWith('en/') && !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const email = 'contact@edgarmejia.com';
---

<Layout
  title="Edgar Mejía - Portfolio"
  description="Personal portfolio of Edgar Mejía, software developer from El Salvador."
  lang="en"
>
  <section class="hero">
    <div class="page-container hero-grid">
      <div class="hero-copy">
        <h1 class="about-h1 reveal">
          <span>Hi there 👋!</span>
          <span>I'm Edgar Mejía,</span>
          <span class="about-sub"><span class="gitch-text"></span></span>
          <span class="about-last">from El Salvador 🇸🇻</span>
        </h1>
        <p class="lead reveal" style="--d:120ms">
          I build mobile apps — iOS, Android and Flutter — and I've been doing it for six-plus years.
          Off the clock I'm a dad, a cat person and an Overwatch player who drinks Coke, never coffee.
        </p>
        <p class="hero-links reveal" style="--d:200ms">
          <a href="#projects" class="btn">See what I've made</a>
          <a href="/about" class="ulink">More about me →</a>
        </p>
      </div>

      <figure class="polaroid reveal" style="--d:160ms">
        <img src="/img/main.webp" alt="Edgar at his desk with an Overwatch match on the second monitor" width="1200" height="1256" />
        <figcaption>me, "working". (that's Overwatch on the right)</figcaption>
        <span class="note n1">girl dad 👧🏻</span>
        <span class="note n2">cat person 🐱</span>
        <span class="note n3">Coke &gt; coffee 🥤</span>
      </figure>
    </div>
  </section>

  {projects.length > 0 && (
    <section id="projects" class="section">
      <div class="page-container">
        <h2 class="sec-title reveal">Things I've <em>made</em></h2>
        <ul class="shelf">
          {projects.map((p, i) => (
            <li class="reveal" style={`--d:${i * 80}ms`}>
              <a href={p.href ?? p.code ?? '#'} class="shelf-row" {...(p.href || p.code ? { target: '_blank', rel: 'noopener' } : {})}>
                <span class="shelf-name">{p.title}</span>
                <span class="shelf-desc">{p.desc}</span>
                <span class="shelf-stack">{p.tags.join(' · ')}</span>
                <span class="shelf-arrow">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section id="writing" class="section">
    <div class="page-container">
      <h2 class="sec-title reveal">Things I've <em>written</em></h2>
      <div class="post-list">
        {posts.map((post, i) => {
          const date = post.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric', month: 'short', day: 'numeric',
          });
          return (
            <a href={`/blog/${post.slug.replace('en/', '')}`} class="post-item reveal" style={`--d:${i * 90}ms`}>
              <p class="post-title">{post.data.title}<span class="arrow"> ↗</span></p>
              <p class="post-meta">{date}</p>
              <p class="post-desc">{post.data.description}</p>
            </a>
          );
        })}
      </div>
      {posts.length > 0 && (
        <a href="/blog" class="ulink more">All posts →</a>
      )}
    </div>
  </section>

  <section id="experience" class="section">
    <div class="page-container">
      <h2 class="sec-title reveal">Where I've <em>worked</em></h2>
      <div class="ledger">
        {experience.map((e, i) => (
          <div class="ledger-row reveal" style={`--d:${i * 80}ms`}>
            <p class="ledger-when">{e.period}{e.current && <span class="now">now</span>}</p>
            <div>
              <p class="ledger-co">{e.company}</p>
              <p class="ledger-role">{e.role}</p>
              <p class="ledger-desc">{e.desc}</p>
            </div>
          </div>
        ))}
      </div>
      <a href="/experience" class="ulink more">Full experience →</a>
    </div>
  </section>

  <section id="contact" class="section section-contact">
    <div class="page-container">
      <h2 class="contact-heading reveal">Say <em>hi.</em></h2>
      <p class="contact-lead reveal">
        Have a project, a job, or just want to talk about cats?
        <button type="button" class="copy-email" data-email={email}><span class="copy-label">{email}</span></button>
      </p>
      <form class="contact-form reveal" id="contact-form" name="contact" method="POST" data-netlify="true">
        <input type="hidden" name="form-name" value="contact" />
        <div class="form-row">
          <div class="form-field">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" placeholder="Your name" required />
          </div>
          <div class="form-field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="your@email.com" required />
          </div>
        </div>
        <div class="form-field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" placeholder="Tell me about your project..." required></textarea>
        </div>
        <button type="submit" class="btn">Send message</button>
      </form>
      <div id="contact-success" style="display:none;" class="contact-success">
        <p>Thanks! I'll get back to you soon.</p>
      </div>
    </div>
  </section>

  <style>
    /* Hero */
    .hero { padding: 9rem 0 5rem; }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.45fr 1fr;
      gap: 3.5rem;
      align-items: center;
    }

    .about-h1 {
      display: flex;
      flex-direction: column;
      font-family: var(--font-display);
      font-weight: 600;
      font-size: clamp(2.4rem, 4.6vw, 4.1rem);
      letter-spacing: -0.035em;
      line-height: 1.02;
      color: var(--fg);
      text-align: left;
      margin: 0;
    }

    .about-h1 span { white-space: nowrap; }

    .about-sub {
      color: var(--accent);
      white-space: nowrap;
    }

    @media (max-width: 480px) {
      .about-h1 { font-size: 2.2rem; }
    }

    .lead {
      max-width: 32rem;
      margin: 2rem 0 0;
      font-size: 1.05rem;
      line-height: 1.65;
      color: var(--fg-muted);
    }

    .hero-links { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; margin: 2rem 0 0; }

    .btn {
      display: inline-block;
      padding: 0.85rem 1.5rem;
      font: 500 0.85rem/1 "Geist Variable", sans-serif;
      letter-spacing: 0.02em;
      text-decoration: none;
      color: var(--body-bg);
      background: var(--fg);
      border: none;
      border-radius: 2px;
      box-shadow: 4px 4px 0 var(--accent);
      cursor: pointer;
      transition: transform 0.15s, box-shadow 0.15s;
    }

    .btn:hover { transform: translate(2px, 2px); box-shadow: 2px 2px 0 var(--accent); }

    .ulink {
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--fg);
      text-decoration: underline;
      text-decoration-color: var(--border);
      text-underline-offset: 5px;
      transition: text-decoration-color 0.2s, color 0.2s;
    }

    .ulink:hover { color: var(--accent); text-decoration-color: var(--accent); }
    .more { display: inline-block; margin-top: 2.5rem; }

    /* Polaroid */
    .polaroid {
      position: relative;
      margin: 0;
      padding: 12px 12px 0;
      background: var(--card);
      border: 1px solid var(--border);
      box-shadow: 0 14px 30px -14px rgba(60, 40, 10, 0.4);
      transform: rotate(2.2deg);
      transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
    }

    .polaroid:hover { transform: rotate(0deg) scale(1.01); }

    .polaroid::before {
      content: "";
      position: absolute;
      top: -14px;
      left: 50%;
      width: 96px;
      height: 28px;
      margin-left: -48px;
      background: rgba(226, 180, 80, 0.55);
      transform: rotate(-4deg);
    }

    .polaroid img {
      display: block;
      width: 100%;
      aspect-ratio: 4 / 4.2;
      object-fit: cover;
      object-position: 30% 40%;
    }

    .polaroid figcaption {
      padding: 0.6rem 0 0.7rem;
      font-size: 0.82rem;
      line-height: 1.4;
      color: var(--fg-muted);
      text-align: center;
    }

    .note {
      position: absolute;
      padding: 0.15rem 0.7rem;
      font-size: 0.8rem;
      font-weight: 500;
      line-height: 1.5;
      color: #3a2d12;
      background: #f7d774;
      box-shadow: 2px 3px 6px rgba(60, 40, 10, 0.25);
      white-space: nowrap;
    }

    .n1 { left: -2.2rem; top: 18%; transform: rotate(-7deg); }
    .n2 { right: -1.2rem; top: 46%; transform: rotate(5deg); background: #f4b6a0; }
    .n3 { left: -1rem; bottom: 22%; transform: rotate(-3deg); background: #bfe0c0; }

    @media (max-width: 860px) {
      .hero-grid { grid-template-columns: 1fr; gap: 3.5rem; }
      .polaroid { max-width: 22rem; margin-inline: auto; }
      .n1 { left: -0.5rem; }
      .n2 { right: -0.5rem; }
      .n3 { left: -0.3rem; }
    }

    /* Sections */
    .section { padding: 5.5rem 0; border-top: 1px dashed var(--border); }

    .sec-title {
      margin: 0 0 3rem;
      font-family: var(--font-display);
      font-weight: 500;
      font-size: clamp(1.9rem, 3.6vw, 2.75rem);
      letter-spacing: -0.03em;
      line-height: 1.1;
      color: var(--fg);
    }

    .sec-title em, .contact-heading em { color: var(--accent); font-style: normal; }

    /* Projects shelf */
    .shelf { list-style: none; margin: 0; padding: 0; }
    .shelf li { border-bottom: 1px dashed var(--border); }

    .shelf-row {
      display: grid;
      grid-template-columns: 1.1fr 1.6fr 1fr auto;
      gap: 1.5rem;
      align-items: baseline;
      padding: 1.4rem 0;
      text-decoration: none;
      transition: padding-left 0.25s, color 0.25s;
    }

    .shelf-row:hover { padding-left: 0.75rem; }
    .shelf-row:hover .shelf-name, .shelf-row:hover .shelf-arrow { color: var(--accent); }

    .shelf-name { font-family: var(--font-display); font-size: 1.5rem; font-weight: 500; letter-spacing: -0.02em; color: var(--fg); transition: color 0.25s; }
    .shelf-desc { font-size: 0.9rem; line-height: 1.55; color: var(--fg-muted); }
    .shelf-stack { font-size: 0.78rem; color: var(--fg-faint); }
    .shelf-arrow { color: var(--fg-faint); transition: color 0.25s; }

    @media (max-width: 760px) {
      .shelf-row { grid-template-columns: 1fr auto; gap: 0.3rem 1rem; }
      .shelf-desc, .shelf-stack { grid-column: 1; }
      .shelf-arrow { grid-row: 1; grid-column: 2; }
    }

    /* Posts (layout kept) */
    .post-list { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0 3rem; }
    .post-item { display: flex; flex-direction: column; text-decoration: none; }

    .post-title {
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--fg);
      letter-spacing: -0.02em;
      margin: 0 0 0.5rem 0;
      line-height: 1.3;
      transition: color 0.2s;
    }

    .post-item .arrow { opacity: 0; display: inline-block; transition: opacity 0.2s, transform 0.2s; }
    .post-item:hover .post-title { color: var(--accent); }
    .post-item:hover .arrow { opacity: 1; transform: translate(2px, -2px); }

    .post-meta { font-size: 0.75rem; color: var(--fg-faint); margin: 0 0 0.75rem 0; letter-spacing: 0.03em; }
    .post-desc { font-size: 0.875rem; color: var(--fg-muted); line-height: 1.65; margin: 0; }

    @media (max-width: 900px) {
      .post-list { grid-template-columns: repeat(2, 1fr); gap: 2rem; }
    }

    @media (max-width: 560px) {
      .post-list { grid-template-columns: 1fr; gap: 0; }
      .post-item { padding: 1.5rem 0; border-top: 1px dashed var(--border); }
    }

    /* Experience ledger */
    .ledger-row {
      display: grid;
      grid-template-columns: 11rem 1fr;
      gap: 1.5rem;
      padding: 1.75rem 0;
      border-bottom: 1px dashed var(--border);
    }

    .ledger-row:first-child { padding-top: 0; }
    .ledger-row p { margin: 0; }

    .ledger-when { font-size: 0.82rem; color: var(--fg-faint); padding-top: 0.55rem !important; }

    .now {
      margin-left: 0.5rem;
      padding: 0 0.4rem;
      font-size: 0.7rem;
      font-weight: 600;
      color: #3a2d12;
      background: #f7d774;
      transform: rotate(-3deg);
      display: inline-block;
    }

    .ledger-co { font-family: var(--font-display); font-size: 1.7rem; font-weight: 500; letter-spacing: -0.02em; color: var(--fg); }
    .ledger-role { font-size: 0.88rem; color: var(--accent); margin: 0.1rem 0 0.6rem !important; }
    .ledger-desc { font-size: 0.95rem; line-height: 1.7; color: var(--fg-muted); max-width: 60ch; }

    @media (max-width: 640px) {
      .ledger-row { grid-template-columns: 1fr; gap: 0.3rem; }
      .ledger-when { padding-top: 0 !important; }
    }

    /* Contact */
    .section-contact { padding-bottom: 8rem; }

    .contact-heading {
      margin: 0 0 1.5rem;
      font-family: var(--font-display);
      font-weight: 600;
      font-size: clamp(3.5rem, 11vw, 8rem);
      letter-spacing: -0.045em;
      line-height: 0.95;
      color: var(--fg);
    }

    .contact-lead { max-width: 34rem; margin: 0 0 3rem; font-size: 1.05rem; line-height: 1.7; color: var(--fg-muted); }

    .copy-email {
      display: block;
      margin-top: 0.4rem;
      padding: 0;
      font-family: var(--font-display);
      font-size: 1.5rem;
      font-weight: 500;
      color: var(--fg);
      background: none;
      border: none;
      border-bottom: 2px solid var(--accent);
      cursor: pointer;
      transition: color 0.2s;
    }

    .copy-email:hover { color: var(--accent); }

    .contact-form { display: flex; flex-direction: column; gap: 1.5rem; max-width: 640px; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .form-field { display: flex; flex-direction: column; gap: 0.4rem; }
    .contact-form .btn { align-self: flex-start; }

    .form-field label { font-size: 0.75rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg-faint); }

    .form-field input,
    .form-field textarea {
      background: none;
      border: none;
      border-bottom: 1px solid var(--border);
      padding: 0.5rem 0;
      font-size: 0.95rem;
      color: var(--fg);
      outline: none;
      resize: none;
      font-family: inherit;
      transition: border-color 0.2s;
    }

    .form-field input::placeholder,
    .form-field textarea::placeholder { color: var(--fg-faint); opacity: 0.6; }
    .form-field input:focus,
    .form-field textarea:focus { border-bottom-color: var(--accent); }

    .contact-success { margin-top: 1.5rem; font-size: 1rem; opacity: 0.7; }

    @media (max-width: 640px) {
      .form-row { grid-template-columns: 1fr; }
    }
  </style>

  <style is:global>
    .dud { color: var(--accent) !important; opacity: 0.5; }
  </style>
</Layout>

<script>
  // Thanks: https://codepen.io/soulwire/pen/mEMPrK

  class TextScramble {
    el: HTMLElement;
    chars: string;
    resolve!: () => void;
    queue: { from: string; to: string; start: number; end: number; char?: string }[] = [];
    frame: number = 0;
    frameRequest: number = 0;

    constructor(el: HTMLElement) {
      this.el = el;
      this.chars = '!<>-_\\/[]{}—=+*^?#火木中大小力__';
      this.update = this.update.bind(this);
    }

    setText(newText: string) {
      const oldText = Array.from(this.el.innerText);
      const newTextArr = Array.from(newText);
      const length = Math.max(oldText.length, newTextArr.length);
      const promise = new Promise<void>((resolve) => (this.resolve = resolve));
      this.queue = [];

      for (let i = 0; i < length; i++) {
        const from = oldText[i] || '';
        const to = newTextArr[i] || '';
        if (from === to) {
          this.queue.push({ from, to, start: 0, end: 0 });
        } else {
          const start = Math.floor(Math.random() * 40);
          const end = start + Math.floor(Math.random() * 40);
          this.queue.push({ from, to, start, end });
        }
      }

      cancelAnimationFrame(this.frameRequest);
      this.frame = 0;
      this.update();
      return promise;
    }

    update() {
      let output = '';
      let complete = 0;

      for (let i = 0, n = this.queue.length; i < n; i++) {
        let { from, to, start, end, char } = this.queue[i];
        if (this.frame >= end) {
          complete++;
          output += to;
        } else if (this.frame >= start) {
          if (!char || Math.random() < 0.28) {
            char = this.randomChar();
            this.queue[i].char = char;
          }
          output += `<span class="dud">${char}</span>`;
        } else {
          output += from;
        }
      }

      this.el.innerHTML = output;

      if (complete === this.queue.length) {
        this.resolve();
      } else {
        this.frameRequest = requestAnimationFrame(this.update);
        this.frame++;
      }
    }

    randomChar() {
      return this.chars[Math.floor(Math.random() * this.chars.length)];
    }
  }

  const phrases = [
    'a Java hater ☕',
    'a Python dev 🐍',
    'a .Net dev',
    'a Swift dev',
    'a Kotlin lover',
    'a Flutter dev',
    'a JS enthusiast',
    'a TS fan or hater?',
    'a Web dev',
    'an OW player 🧡',
    'a Coffee hater :)',
    'a Pre-AI dev 🗿',
    'a Coke lover 🥤',
    'a Girl dad 👧🏻',
    'a Cat lover 🐱',
  ];

  function initScramble() {
    const el = document.querySelector<HTMLElement>('.gitch-text');
    if (!el) return;

    // ponytail: reduced motion gets a static phrase instead of the endless loop
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.textContent = phrases[3];
      return;
    }

    const fx = new TextScramble(el);
    let lastIndex = -1;

    const next = () => {
      let randomIndex: number;
      do {
        randomIndex = Math.floor(Math.random() * phrases.length);
      } while (randomIndex === lastIndex);

      lastIndex = randomIndex;
      fx.setText(phrases[randomIndex]).then(() => {
        setTimeout(next, 1200);
      });
    };

    next();
  }

  document.addEventListener('astro:page-load', initScramble);

  function initReveal() {
    const els = document.querySelectorAll<HTMLElement>('.reveal');
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (en.isIntersecting) {
          en.target.classList.remove('pre');
          io.unobserve(en.target);
        }
      });
    }, { threshold: 0.12 });
    els.forEach((el) => {
      // only hide what is not already on screen, so above-the-fold content never flashes
      if (el.getBoundingClientRect().top > innerHeight * 0.9) el.classList.add('pre');
      io.observe(el);
    });
  }

  document.addEventListener('astro:page-load', initReveal);

  function initContact() {
    const btn = document.querySelector<HTMLButtonElement>('.copy-email');
    btn?.addEventListener('click', async () => {
      const label = btn.querySelector('.copy-label')!;
      const email = btn.dataset.email!;
      try { await navigator.clipboard.writeText(email); label.textContent = 'Copied ✓'; }
      catch { location.href = `mailto:${email}`; return; }
      setTimeout(() => (label.textContent = email), 1600);
    });

    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const success = document.getElementById('contact-success') as HTMLElement | null;
    if (!form || !success) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new URLSearchParams(new FormData(form) as unknown as Record<string, string>);
      await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: data.toString() });
      form.style.display = 'none';
      success.style.display = 'block';
    });
  }

  document.addEventListener('astro:page-load', initContact);
</script>
