---
import Layout from '../layouts/Layout.astro';
import Contact from '../components/home/Contact.astro';
import Experience from '../components/home/Experience.astro';
import Hero from '../components/home/Hero.astro';
import Projects from '../components/home/Projects.astro';
import SectionNav from '../components/home/SectionNav.astro';
import Writing from '../components/home/Writing.astro';
import { site } from '../data/site';
---

<Layout
  title={`${site.name} — ${site.role}`}
  description={`${site.name}, mobile developer from El Salvador building iOS, Android and Flutter apps.`}
  lang="en"
>
  <Hero />
  <SectionNav />
  <Projects />
  <Writing />
  <Experience />
  <Contact />
</Layout>
