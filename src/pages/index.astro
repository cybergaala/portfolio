---
import Layout from "../layouts/Layout.astro";
import { getCollection } from 'astro:content';
import { experience } from '../data/experience';
import { projects } from '../data/projects';
// ANSI half-block art, generated with scripts/ascii-art.py --ansi (the .ascii.json files keep the earlier ASCII take)
import art from '../data/hero-art.json';
// color blocks taken from the art itself (scripts/ascii-art.py --palette)
import palette from '../data/hero-palette.json';

// art only holds ASCII and hex colors from our own script, so it is safe as raw HTML
const toHtml = (rows: typeof art) =>
  rows.map((row) => row.map(([fg, bg, t]) => (fg ? `<span style="color:${fg}${bg ? `;background:${bg}` : ''}">${t}</span>` : t)).join('')).join('\n');

const posts = (await getCollection('blog', ({ id, data }) => id.startsWith('en/') && !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const email = 'contact@edgarmejia.com';

// fastfetch-style hero; keys follow fastfetch's module names
const fetch: [string, string][] = [
  ['User', 'Edgar Mejía'],
  ['Host', 'PBS El Salvador'],
  ['Kernel', 'Mobile Developer'],
  ['Uptime', '6+ years shipping'],
  ['Packages', 'Swift, Kotlin, Flutter'],
  ['CPU', 'Coca-Cola 🥤 (no coffee)'],
  ['Memory', 'girl dad 👧🏻 · cat 🐱'],
];

// ASCII star field behind the hero; seeded so every build renders the same sky
let seed = 7;
const rand = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const stars = Array.from({ length: 70 }, () => ({
  char: ['.', '.', '.', '*', '+', "'"][Math.floor(rand() * 6)],
  x: (rand() * 100).toFixed(1),
  y: (rand() * 100).toFixed(1),
  twinkle: rand() < 0.3,
  delay: (rand() * 4).toFixed(1),
  red: rand() < 0.12,
}));

// lazygit-style commit hashes, derived from the company name so they never change
const hash = (str: string) => {
  let h = 5381;
  for (const c of str) h = ((h * 33) ^ c.charCodeAt(0)) >>> 0;
  return h.toString(16).padStart(8, '0').slice(0, 7);
};

// lazygit graph: one string per row, a rail every 2 chars (main, fullstack, life)
const [pbs, thinkforward, serfinsa, hightech] = experience;
type Label = [string, 'head' | 'branch' | 'tag'];
type Commit = { graph: string; labels?: Label[]; msg?: string; date?: string; desc?: string; job?: typeof pbs };

const commits: Commit[] = ([
  { graph: '⏣─╮ │', labels: [['HEAD -> main', 'head']], msg: "Merge branch 'fullstack' into main", date: 'Apr 2024', desc: 'Wrapped up the ERP work and went back to mobile full time.' },
  { graph: '◯ │ │', labels: [['v3.0', 'tag']], job: pbs },
  { graph: '│ │ ◯', labels: [['life', 'branch']], msg: 'feat(life): girl dad 👧🏻', desc: 'Best release so far. Zero patience for loading spinners.' },
  { graph: '◯ │ │', labels: [['v2.1', 'tag']], job: serfinsa },
  { graph: '│ ◯ │', labels: [['fullstack', 'branch']], job: thinkforward },
  { graph: '◯─╯ │', msg: 'chore: wrap up Hightech Consulting', date: 'Aug 2023' },
  { graph: '│   ◯', msg: 'feat(life): adopt a cat 🐱', desc: 'Chief keyboard inspector. Reviews every PR by walking on it.' },
  { graph: '◯   │', labels: [['v2.0', 'tag']], job: hightech },
  { graph: '◯───╯', labels: [['v0.1', 'tag']], msg: 'init: hello, world', date: 'a long time ago', desc: 'First line of code. Probably a missing semicolon.' },
] as Commit[]).map((c) => c.job
  ? { ...c, msg: `feat: ${c.job.role} @ ${c.job.company}`, date: c.job.period, desc: c.job.desc }
  : c);

// color each graph char by the rail it belongs to
const rail = (i: number) => ['r0', 'r1', 'r2'][Math.floor((i + 1) / 2)];

// 'Mar 2024 — Present' -> '2024-03 → now'
const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const shortDate = (d: string) => {
  const [m, y] = d.trim().split(' ');
  return m === 'Present' ? 'now' : `${y}-${String(months.indexOf(m) + 1).padStart(2, '0')}`;
};
const shortPeriod = (p: string) => p.split('—').map(shortDate).join(' → ');

// `ls -l` columns for projects and posts
const lsDate = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).replace(',', '');
const lsSize = (bytes: number) => `${(bytes / 1024).toFixed(1)}K`;
const linkTarget = (url: string) => url.replace(/^https?:\/\//, '');

// open on the current job instead of the merge commit
const selected = commits.findIndex((c) => c.job?.current);
---

<Layout
  title="Edgar Mejía — Mobile Developer"
  description="Edgar Mejía, mobile developer from El Salvador building iOS, Android and Flutter apps."
  lang="en"
>
  <section class="hero">
    <div class="sky mono" aria-hidden="true">
      {stars.map((st) => (
        <span class:list={{ twinkle: st.twinkle, red: st.red }} style={`left:${st.x}%;top:${st.y}%;--delay:${st.delay}s`}>{st.char}</span>
      ))}
    </div>
    <div class="page-container">
      <h1 class="sr-only">Edgar Mejía — mobile developer in San Salvador</h1>
      <div class="term reveal">
        <div class="term-body mono">
          <p class="term-cmd"><span class="path">~</span> $ fastfetch</p>
          <div class="ff">
            <pre class="ff-art" aria-hidden="true" set:html={toHtml(art)} />
            <div class="ff-info">
              <p class="ff-title"><span class="ff-key">edgar</span>@<span class="ff-key">san-salvador</span></p>
              <p class="ff-rule" aria-hidden="true">------------------</p>
              {fetch.map(([k, v]) => <p><span class="ff-key">{k}</span>: {v}</p>)}
              <p><span class="ff-key">Status</span>: <span class="dot" aria-hidden="true"></span> open to new projects</p>
              <p class="ff-colors" aria-hidden="true">{palette.map((c) => <span style={`background:${c}`}></span>)}</p>
            </div>
          </div>
          <p class="term-cmd"><span class="path">~</span> $ ls ~/links</p>
          <p class="ff-links">
            <a href="#contact">say-hi.sh</a>
            <a href="https://github.com/cybergaala" target="_blank" rel="noopener">github ↗</a>
            <a href="https://www.linkedin.com/in/mejia-edgar/" target="_blank" rel="noopener">linkedin ↗</a>
          </p>
          <p class="term-cmd"><span class="path">~</span> $ <span class="caret" aria-hidden="true"></span></p>
        </div>
      </div>
    </div>
  </section>

  {projects.length > 0 && (
    <section id="projects" class="section">
      <div class="page-container">
        <header class="sec-head reveal">
          <p class="cmd">$ ls -l ~/projects</p>
          <h2 class="sec-title">Projects</h2>
        </header>
        <div class="ls ls-dirs mono reveal">
          <p class="ls-total">total {projects.length}</p>
          {projects.map((p) => {
            const link = p.href ?? p.code;
            return (
              <a href={link ?? '#'} class="ls-row" {...(link ? { target: '_blank', rel: 'noopener' } : {})}>
                <span class="ls-perm">{link ? 'lrwxr-xr-x' : 'drwxr-xr-x'}</span>
                <span class="ls-owner">edgar</span>
                <span class="ls-group">{p.tags[0].toLowerCase()}</span>
                <span class="ls-size">4.0K</span>
                <span class="ls-name dir">{link ? <>{p.title} <span class="ls-arrow">-&gt; {linkTarget(link)}</span></> : `${p.title}/`}</span>
                <span class="ls-note"># {p.desc}</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <section id="experience" class="section">
    <div class="page-container">
      <header class="sec-head reveal">
        <p class="cmd">$ lazygit</p>
        <h2 class="sec-title">Experience</h2>
      </header>
      <div class="lg mono reveal" data-lazygit>
        <div class="lg-panel lg-commits">
          <span class="lg-title">[4] Commits</span>
          <ul class="lg-list" role="listbox" aria-label="Experience" tabindex="0">
            {commits.map((c, i) => (
              <li role="option" aria-selected={i === selected ? 'true' : 'false'} class:list={{ job: c.job }} data-i={i}>
                <span class="lg-hash">{hash(c.msg!)}</span>
                <span class="lg-graph" aria-hidden="true">{[...c.graph].map((ch, j) => <span class={rail(j)}>{ch}</span>)}</span>
                <span class="lg-msg">
                  {c.labels?.map(([t, k]) => <span class={`lg-label ${k}`}>{t}</span>)}
                  {c.job
                    ? <><span class="lg-co">{c.job.company}</span> <span class="lg-role">{c.job.role}</span></>
                    : <span class="lg-note">{c.msg}</span>}
                </span>
                {c.job && <span class="lg-date">{shortPeriod(c.job.period)}</span>}
              </li>
            ))}
          </ul>
          <span class="lg-count"><span data-pos>{selected + 1}</span> of {commits.length}</span>
        </div>

        <div class="lg-panel lg-patch">
          <span class="lg-title">Patch</span>
          {commits.map((c, i) => (
            <div class="lg-detail" data-detail={i} hidden={i !== selected}>
              <p><span class="lg-hash">commit {hash(c.msg!)}</span>{c.labels && <span> ({c.labels.map(([t]) => t).join(', ')})</span>}</p>
              {c.graph.startsWith('⏣') && <p>{'Merge:  '}{hash(pbs.company)} {hash(thinkforward.company)}</p>}
              <p>Author: Edgar Mejía &lt;contact@edgarmejia.com&gt;</p>
              {c.date && <p>{'Date:   '}{c.date}</p>}
              <p class="lg-body">{c.msg}</p>
              {c.desc && <p class="lg-body lg-desc">{c.desc}</p>}
              {c.job && (
                <>
                  <p class="lg-file">--- a/stack.txt<br />+++ b/stack.txt</p>
                  {c.job.tags.map((t) => <p class="lg-add">+ {t}</p>)}
                </>
              )}
            </div>
          ))}
        </div>

        <p class="lg-keys">navigate: <span>↑/↓</span> <span>j/k</span> · select: <span>click</span></p>
      </div>
      <a href="/experience" class="more mono">full log →</a>
    </div>
  </section>

  {posts.length > 0 && (
    <section id="writing" class="section">
      <div class="page-container">
        <header class="sec-head reveal">
          <p class="cmd">$ ls -lt ~/blog | head -3</p>
          <h2 class="sec-title">Writing</h2>
        </header>
        <div class="ls mono reveal">
          {posts.map((post) => (
            <a href={`/blog/${post.slug.replace('en/', '')}`} class="ls-row">
              <span class="ls-perm">-rw-r--r--</span>
              <span class="ls-owner">edgar</span>
              <span class="ls-group">staff</span>
              <span class="ls-size">{lsSize(post.body.length)}</span>
              <span class="ls-date">{lsDate(post.data.pubDate)}</span>
              <span class="ls-name">{post.slug.replace('en/', '')}.md</span>
              <span class="ls-note"># {post.data.title}</span>
            </a>
          ))}
        </div>
        <a href="/blog" class="more mono">all posts →</a>
      </div>
    </section>
  )}

  <section id="contact" class="section">
    <div class="page-container contact-grid">
      <div class="reveal">
        <p class="cmd">$ mail edgar</p>
        <h2 class="contact-heading">Got a project?<br />Let's talk.</h2>
        <p class="lead">Freelance, a full-time role, or just cats. I usually reply within a day.</p>
        <button type="button" class="copy-email mono" data-email={email}><span class="copy-label">{email}</span> <span class="copy-hint">[copy]</span></button>
      </div>
      <div class="reveal" style="--d:100ms">
        <form class="window contact-form" id="contact-form" name="contact" method="POST" data-netlify="true">
          <div class="tabs mono"><span>new-message.txt</span></div>
          <div class="form-body">
            <input type="hidden" name="form-name" value="contact" />
            <div class="form-row">
              <label class="field"><span class="mono">name:</span><input type="text" name="name" placeholder="Your name" required /></label>
              <label class="field"><span class="mono">email:</span><input type="email" name="email" placeholder="your@email.com" required /></label>
            </div>
            <label class="field"><span class="mono">message:</span><textarea name="message" rows="5" placeholder="Tell me about your project..." required></textarea></label>
            <button type="submit" class="btn mono">send ⏎</button>
          </div>
        </form>
        <div id="contact-success" style="display:none;" class="window contact-success mono">
          <p><span class="ok">✓</span> sent. I'll get back to you soon.</p>
        </div>
      </div>
    </div>
  </section>

  <style>
    .mono { font-family: var(--font-mono); }

    .cmd {
      margin: 0 0 1rem;
      font: 0.8rem/1.4 var(--font-mono);
      color: var(--fg-faint);
    }

    .path { color: var(--accent); }
    .branch { color: var(--syn-kw); }

    /* Hero */
    .hero { position: relative; overflow: hidden; padding: 5.5rem 0 5rem; }
    .hero > .page-container { position: relative; }

    .sky { position: absolute; inset: 0; pointer-events: none; font-size: 0.85rem; color: var(--fg-faint); }
    .sky span { position: absolute; line-height: 1; opacity: 0.55; }
    .sky .red { color: var(--accent); opacity: 0.8; }

    @media (prefers-reduced-motion: no-preference) {
      .sky .twinkle { animation: twinkle 3.5s ease-in-out var(--delay) infinite; }
    }

    @keyframes twinkle { 50% { opacity: 0.1; } }

    .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

    .lead {
      max-width: 30rem;
      margin: 1.25rem 0 0;
      font-size: 1.05rem;
      line-height: 1.65;
      color: var(--fg-muted);
    }

    .dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #3ecf6e; box-shadow: 0 0 0 3px rgba(62, 207, 110, 0.2); vertical-align: middle; }

    .btn {
      display: inline-flex;
      align-items: center;
      padding: 0.6rem 1rem;
      font-size: 0.82rem;
      font-weight: 500;
      text-decoration: none;
      color: var(--body-bg);
      background: var(--accent);
      border: 1px solid var(--accent);
      border-radius: 6px;
      cursor: pointer;
      transition: opacity 0.2s, border-color 0.2s, color 0.2s;
    }

    .btn:hover { opacity: 0.85; }
    .btn-ghost { color: var(--fg-muted); background: transparent; border-color: var(--border); }
    .btn-ghost:hover { opacity: 1; color: var(--fg); border-color: var(--fg-faint); }

    /* Editor window */
    .window {
      overflow: hidden;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 10px;
    }

    .tabs { display: flex; border-bottom: 1px solid var(--border); font-size: 0.75rem; }

    .tabs span { padding: 0.6rem 1rem; color: var(--fg-muted); border-right: 1px solid var(--border); }

    /* fastfetch */
    /* no window chrome: the output sits on the page, right under the header prompt */
    .term-body { padding: 0; font-size: 0.8rem; line-height: 1.7; color: var(--fg); }
    .term-body p { margin: 0; }
    .term-cmd { color: var(--fg-muted); }

    .ff { display: grid; grid-template-columns: auto 1fr; gap: 2rem; margin-top: 1rem; align-items: center; }
    .ff-key { color: var(--accent); font-weight: 600; }
    .ff-title { font-weight: 600; }
    .ff-rule { color: var(--fg-faint); }
    .ff-colors { display: flex; margin-top: 0.75rem !important; }
    .ff-colors span { width: 1.4rem; height: 0.9rem; }

    /* 128 columns of art: shrink the glyphs so it always fits the viewport */
    .ff-art {
      font: min(8.2px, calc((100vw - 5rem) / 77)) / 1 var(--font-mono);
      letter-spacing: 0;
      user-select: none;
      margin: 0;
    }

    /* cells exactly one row tall so the half blocks stack into square pixels */
    .ff-art :global(span) { display: inline-block; height: 1em; vertical-align: top; }

    .ff-links { display: flex; flex-wrap: wrap; gap: 0.4rem 2rem; }
    .ff-links a { color: var(--syn-type); text-decoration: none; }
    .ff-links a:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }

    .term-body > .term-cmd:not(:first-child) { margin-top: 1rem !important; }

    .caret { display: inline-block; width: 0.55em; height: 1.1em; vertical-align: text-bottom; background: var(--accent); }

    @media (prefers-reduced-motion: no-preference) {
      .caret { animation: blink 1.1s steps(1) infinite; }
    }

    @keyframes blink { 50% { opacity: 0; } }

    @media (max-width: 960px) {
      .ff { grid-template-columns: 1fr; gap: 1.25rem; }
    }

    @media (max-width: 900px) {
      .hero { padding-top: 6rem; }
    }

    /* Sections */
    .section { padding: 5rem 0; border-top: 1px solid var(--border); }

    .sec-head { margin-bottom: 2rem; }
    .sec-head .cmd { margin-bottom: 0.4rem; }

    .sec-title {
      margin: 0;
      font-family: var(--font-display);
      font-weight: 600;
      font-size: clamp(1.6rem, 3vw, 2rem);
      letter-spacing: -0.03em;
      color: var(--fg);
    }

    .more { display: inline-block; margin-top: 1.75rem; font-size: 0.8rem; color: var(--accent); text-decoration: none; }
    .more:hover { text-decoration: underline; text-underline-offset: 4px; }

    /* ls -l (projects + posts): rows share one grid so columns line up like a terminal */
    .ls {
      display: grid;
      grid-template-columns: repeat(6, auto) 1fr;
      column-gap: 1.5ch;
      font-size: 0.82rem;
      line-height: 1.6;
    }

    .ls-dirs { grid-template-columns: repeat(5, auto) 1fr; }
    .ls-total { grid-column: 1 / -1; margin: 0 0 0.25rem; color: var(--fg-faint); }

    .ls-row {
      display: grid;
      grid-column: 1 / -1;
      grid-template-columns: subgrid;
      padding: 0.2rem 0.4rem;
      margin: 0 -0.4rem;
      color: var(--fg-muted);
      text-decoration: none;
      white-space: nowrap;
      border-radius: 3px;
    }

    .ls-row:hover { background: var(--accent-soft); }
    .ls-perm, .ls-owner, .ls-group { color: var(--fg-faint); }
    .ls-size { text-align: right; }
    .ls-date { color: var(--syn-type); }
    .ls-name { color: var(--fg); font-weight: 600; }
    .ls-name.dir { color: var(--accent); }
    .ls-arrow { font-weight: 400; color: var(--fg-muted); }
    .ls-note { min-width: 0; overflow: hidden; text-overflow: ellipsis; color: var(--fg-faint); }
    .ls-row:hover .ls-name { text-decoration: underline; text-underline-offset: 3px; }

    @media (max-width: 720px) {
      .ls-perm, .ls-owner, .ls-group { display: none; }
      .ls { grid-template-columns: auto auto 1fr; }
      .ls-dirs { grid-template-columns: auto 1fr; }
      .ls-dirs .ls-size { display: none; }
      .ls:not(.ls-dirs) .ls-note { display: none; }
    }

    /* lazygit */
    .lg { display: grid; grid-template-columns: 1.75fr 1fr; gap: 0.6rem; font-size: 0.8rem; line-height: 1.65; }
    .lg p { margin: 0; }

    .lg-panel {
      position: relative;
      min-width: 0;
      padding: 1rem 0.9rem 1.1rem;
      border: 1px solid var(--border);
      border-radius: 8px;
    }

    /* the focused panel gets lazygit's highlighted border */
    .lg-commits:focus-within, .lg-commits:hover { border-color: var(--syn-type); }

    .lg-title, .lg-count {
      position: absolute;
      padding: 0 0.35rem;
      font-size: 0.75rem;
      background: var(--body-bg);
    }

    .lg-title { top: -0.6rem; left: 0.7rem; color: var(--fg); font-weight: 600; }
    .lg-count { bottom: -0.6rem; right: 0.7rem; color: var(--fg-faint); }
    .lg-commits:focus-within .lg-title, .lg-commits:hover .lg-title { color: var(--syn-type); }

    .lg-list { list-style: none; margin: 0; padding: 0; outline: none; }

    /* tight rows so the box-drawing rails connect like terminal cells */
    .lg-list li {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      height: 1.4em;
      padding: 0 0.4rem;
      line-height: 1.4;
      white-space: nowrap;
      cursor: pointer;
      border-radius: 3px;
    }

    .lg-list li:hover { background: var(--accent-soft); }
    .lg-list li[aria-selected="true"] { background: color-mix(in srgb, var(--syn-type) 22%, transparent); }

    .lg-hash { color: var(--syn-num); }
    .lg-graph { white-space: pre; font-size: 1.15em; line-height: 1.22; }
    .r0 { color: var(--accent); }
    .r1 { color: var(--syn-type); }
    .r2 { color: #3ecf6e; }

    .lg-label { margin-right: 0.5em; font-weight: 600; }
    .lg-label.head { color: var(--syn-type); }
    .lg-label.branch { color: #3ecf6e; }
    .lg-label.tag { color: var(--syn-num); }
    .lg-label.tag::before { content: "#"; }
    .lg-msg { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; color: var(--fg); }
    .lg-co { font-weight: 600; color: var(--fg); }
    .lg-role { color: var(--fg-muted); }
    .lg-note { color: var(--fg-faint); }
    .lg-date { flex-shrink: 0; width: 17ch; text-align: right; color: var(--syn-type); }
    .lg-list li:not(.job) .lg-hash { opacity: 0.55; }

    .lg-detail { color: var(--fg-muted); }
    .lg-detail p { white-space: pre-wrap; }
    .lg-head { color: var(--fg-muted); }
    .lg-ok, .lg-add { color: #3ecf6e; }
    .lg-body { margin-top: 0.9rem !important; padding-left: 2rem; color: var(--fg); }
    .lg-desc { margin-top: 0.5rem !important; color: var(--fg-muted); white-space: normal; }
    .lg-file { margin-top: 1rem !important; color: var(--fg); font-weight: 600; }

    .lg-keys { grid-column: 1 / -1; margin-top: 0.6rem !important; font-size: 0.72rem; color: var(--fg-faint); }
    .lg-keys span { color: var(--syn-type); }

    @media (max-width: 860px) {
      .lg { grid-template-columns: 1fr; gap: 1.4rem; }
      .lg-keys { margin-top: 0 !important; }
    }

    /* Contact */
    #contact { padding-bottom: 7rem; }
    .contact-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 4rem; align-items: start; }

    .contact-heading {
      margin: 0;
      font-family: var(--font-display);
      font-weight: 600;
      font-size: clamp(2.2rem, 4.5vw, 3.2rem);
      letter-spacing: -0.04em;
      line-height: 1.05;
      color: var(--fg);
    }

    .copy-email {
      margin-top: 1.75rem;
      padding: 0;
      font-size: 0.95rem;
      color: var(--accent);
      background: none;
      border: none;
      cursor: pointer;
    }

    .copy-hint { color: var(--fg-faint); }
    .copy-email:hover .copy-hint { color: var(--accent); }

    .form-body { display: flex; flex-direction: column; gap: 1.1rem; padding: 1.25rem; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .field { display: flex; flex-direction: column; gap: 0.35rem; }
    .field > span { font-size: 0.75rem; color: var(--syn-kw); }
    .contact-form .btn { align-self: flex-start; }

    .field input,
    .field textarea {
      padding: 0.6rem 0.75rem;
      font: 0.9rem "Geist Variable", sans-serif;
      color: var(--fg);
      background: var(--body-bg);
      border: 1px solid var(--border);
      border-radius: 6px;
      outline: none;
      resize: vertical;
      transition: border-color 0.2s;
    }

    .field input::placeholder,
    .field textarea::placeholder { color: var(--fg-faint); }
    .field input:focus,
    .field textarea:focus { border-color: var(--accent); }

    .contact-success { padding: 1.25rem; font-size: 0.88rem; color: var(--fg); }
    .contact-success p { margin: 0; }
    .ok { color: #3ecf6e; }

    @media (max-width: 860px) {
      .contact-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    }

    @media (max-width: 560px) {
      .form-row { grid-template-columns: 1fr; }
    }
  </style>
</Layout>

<script>
  function initLazygit() {
    const root = document.querySelector<HTMLElement>('[data-lazygit]');
    if (!root) return;
    const list = root.querySelector<HTMLElement>('.lg-list')!;
    const rows = [...list.querySelectorAll<HTMLElement>('li')];
    const details = [...root.querySelectorAll<HTMLElement>('[data-detail]')];
    const pos = root.querySelector('[data-pos]')!;
    let current = Math.max(0, rows.findIndex((r) => r.getAttribute('aria-selected') === 'true'));

    const select = (i: number) => {
      current = (i + rows.length) % rows.length;
      rows.forEach((r, j) => r.setAttribute('aria-selected', String(j === current)));
      details.forEach((d, j) => (d.hidden = j !== current));
      pos.textContent = String(current + 1);
    };

    rows.forEach((r, i) => r.addEventListener('click', () => { select(i); list.focus(); }));
    list.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'j') select(current + 1);
      else if (e.key === 'ArrowUp' || e.key === 'k') select(current - 1);
      else return;
      e.preventDefault();
    });
  }

  document.addEventListener('astro:page-load', initLazygit);

  function initReveal() {
    const els = document.querySelectorAll<HTMLElement>('.reveal');
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (en.isIntersecting) {
          en.target.classList.remove('pre');
          io.unobserve(en.target);
        }
      });
    }, { threshold: 0.12 });
    els.forEach((el) => {
      // only hide what is not already on screen, so above-the-fold content never flashes
      if (el.getBoundingClientRect().top > innerHeight * 0.9) el.classList.add('pre');
      io.observe(el);
    });
  }

  document.addEventListener('astro:page-load', initReveal);

  function initContact() {
    const btn = document.querySelector<HTMLButtonElement>('.copy-email');
    btn?.addEventListener('click', async () => {
      const label = btn.querySelector('.copy-label')!;
      const email = btn.dataset.email!;
      try { await navigator.clipboard.writeText(email); label.textContent = 'copied ✓'; }
      catch { location.href = `mailto:${email}`; return; }
      setTimeout(() => (label.textContent = email), 1600);
    });

    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const success = document.getElementById('contact-success') as HTMLElement | null;
    if (!form || !success) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new URLSearchParams(new FormData(form) as unknown as Record<string, string>);
      await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: data.toString() });
      form.style.display = 'none';
      success.style.display = 'block';
    });
  }

  document.addEventListener('astro:page-load', initContact);
</script>
