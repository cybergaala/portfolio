---
import type { GetStaticPaths, Page } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/ui';

const t = useTranslations('en');

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection('blog', ({ id, data }) => id.startsWith('en/') && !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return paginate(posts, { pageSize: 10 });
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<CollectionEntry<'blog'>> };
const posts = page.data;

// same `ls -l` columns as the landing's Writing section
const lsDate = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).replace(',', '');
const lsSize = (bytes: number) => `${(bytes / 1024).toFixed(1)}K`;
const pageHref = (n: number) => (n === 1 ? '/blog' : `/blog/${n}`);
---

<Layout title={t('blog.writing')} description={t('blog.writing-description')} lang="en">
  <section class="blog-index">
    <div class="page-container">
      <header class="sec-head">
        <p class="cmd">$ ls -lt ~/blog{page.lastPage > 1 && ` | sed -n '${page.start + 1},${page.end + 1}p'`}</p>
        <h1 class="sec-title">Writing</h1>
      </header>
      <div class="ls mono">
        <p class="ls-total">total {page.total}</p>
        {posts.map((post) => (
          <a href={`/blog/${post.slug.replace('en/', '')}`} class="ls-row">
            <span class="ls-perm">-rw-r--r--</span>
            <span class="ls-owner">edgar</span>
            <span class="ls-group">staff</span>
            <span class="ls-size">{lsSize(post.body.length)}</span>
            <span class="ls-date">{lsDate(post.data.pubDate)}</span>
            <span class="ls-name">{post.slug.replace('en/', '')}.md</span>
            <span class="ls-note"># {post.data.title}</span>
          </a>
        ))}
      </div>

      {page.lastPage > 1 && (
        <nav class="pager mono" aria-label="Pagination">
          {page.url.prev ? <a href={page.url.prev}>{t('blog.prev')}</a> : <span class="off">{t('blog.prev')}</span>}
          <span class="pages">
            {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((n) => (
              <a href={pageHref(n)} aria-current={n === page.currentPage ? 'page' : undefined}>{n}</a>
            ))}
          </span>
          {page.url.next ? <a href={page.url.next}>{t('blog.next')}</a> : <span class="off">{t('blog.next')}</span>}
          <span class="pos">(page {page.currentPage}/{page.lastPage})</span>
        </nav>
      )}
    </div>
  </section>
</Layout>

<style>
  .blog-index { padding: 9rem 0 6rem; }

  /* less(1)-style pager line */
  .pager { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 1.5ch; margin-top: 2rem; font-size: 0.8rem; color: var(--fg-faint); }
  .pager a { padding: 0 0.4rem; color: var(--syn-type); text-decoration: none; border-radius: 3px; }
  .pager a:hover { background: var(--accent-soft); color: var(--accent); }
  .pager .off { padding: 0 0.4rem; opacity: 0.5; }
  .pages { display: flex; gap: 0.25ch; }
  .pages a[aria-current] { color: var(--body-bg); background: var(--accent); font-weight: 600; }
  .pos { margin-left: auto; }
</style>
